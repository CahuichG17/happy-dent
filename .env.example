# ─────────────────────────────────────────────
# Happy Dent — variables de entorno
# Copia este archivo a .env y rellena los valores.
# ─────────────────────────────────────────────

# URL pública del sitio (para SEO/canonical y enlaces de QR). En Railway: https://tu-app.up.railway.app
# IMPORTANTE: establece esta variable en Railway o los enlaces de opinion mostraran localhost.
PUBLIC_SITE_URL=https://happy-dent.example.com

# Postgres (Railway → pestaña Postgres → Connect → Connection URL)
DATABASE_URL=postgres://usuario:password@host:5432/railway

# Better Auth
BETTER_AUTH_SECRET=genera-un-secreto-largo-aleatorio
BETTER_AUTH_URL=http://localhost:4321

# Subida de fotos (doctoras/servicios). Se guardan en disco.
# En Railway: crea un Volume montado en /data y pon UPLOAD_DIR=/data/uploads
# para que las imágenes sobrevivan a los redeploys. En local se omite (usa ./uploads).
UPLOAD_DIR=

# WhatsApp de la clínica (notificaciones de citas/cotizaciones)
PUBLIC_WHATSAPP_NUMBER=529983229592
