---
import { getCopy } from '../lib/copy';
const c = await getCopy();
---

<section class="ba-section" id="resultados">
  <div class="container">
    <div class="ba-header">
      <span class="section-tag">
        <span data-es>{c['ba.tag'].es}</span><span data-en>{c['ba.tag'].en}</span>
      </span>
      <h2 class="section-title">
        <span data-es set:html={c['ba.title'].es}></span>
        <span data-en set:html={c['ba.title'].en}></span>
      </h2>
      <p class="section-subtitle">
        <span data-es>{c['ba.subtitle'].es}</span>
        <span data-en>{c['ba.subtitle'].en}</span>
      </p>
    </div>

    <div class="ba-slider" id="baSlider" data-hover>
      <!-- AFTER (bottom layer, always visible) -->
      <div class="ba-layer ba-after">
        <svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-label="Sonrisa después del tratamiento">
          <defs>
            <linearGradient id="afterBg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#FFF0F6"/>
              <stop offset="100%" stop-color="#F0E6F6"/>
            </linearGradient>
            <radialGradient id="afterGlow" cx="0.5" cy="0.55">
              <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <rect width="800" height="500" fill="url(#afterBg)"/>
          <ellipse cx="400" cy="275" rx="280" ry="170" fill="url(#afterGlow)"/>
          <!-- Bright clean smile -->
          <path d="M250 250 Q400 380 550 250 Q400 290 250 250 Z" fill="#2D2235" opacity="0.4"/>
          <g>
            <rect x="290" y="248" width="30" height="42" rx="5" fill="#FFFFFF"/>
            <rect x="324" y="252" width="28" height="44" rx="5" fill="#FFFFFF"/>
            <rect x="356" y="254" width="32" height="46" rx="5" fill="#FFFFFF"/>
            <rect x="392" y="254" width="32" height="46" rx="5" fill="#FFFFFF"/>
            <rect x="428" y="252" width="28" height="44" rx="5" fill="#FFFFFF"/>
            <rect x="460" y="248" width="30" height="42" rx="5" fill="#FFFFFF"/>
          </g>
          <circle cx="600" cy="160" r="6" fill="#FFB1D7"/>
          <circle cx="190" cy="380" r="4" fill="#D8B9EB"/>
          <text x="50" y="60" font-family="Plus Jakarta Sans" font-size="22" font-weight="700" fill="#D96DA5">DESPUÉS · AFTER</text>
        </svg>
      </div>

      <!-- BEFORE (top layer, clipped) -->
      <div class="ba-layer ba-before" id="baBefore">
        <svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-label="Sonrisa antes del tratamiento">
          <defs>
            <linearGradient id="beforeBg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#FFFAF8"/>
              <stop offset="100%" stop-color="#FFF0EB"/>
            </linearGradient>
          </defs>
          <rect width="800" height="500" fill="url(#beforeBg)"/>
          <!-- Discolored uneven smile -->
          <path d="M250 250 Q400 380 550 250 Q400 280 250 250 Z" fill="#2D2235" opacity="0.45"/>
          <g>
            <rect x="288" y="252" width="28" height="40" rx="3" fill="#E8DCC4" transform="rotate(-3 302 272)"/>
            <rect x="320" y="256" width="30" height="42" rx="3" fill="#E0D2B0"/>
            <rect x="354" y="260" width="28" height="42" rx="3" fill="#D9C8A0" transform="rotate(2 368 281)"/>
            <rect x="386" y="258" width="32" height="44" rx="3" fill="#DDC9A2"/>
            <rect x="422" y="256" width="28" height="42" rx="3" fill="#E0D2B0" transform="rotate(-2 436 277)"/>
            <rect x="456" y="252" width="30" height="40" rx="3" fill="#E8DCC4"/>
          </g>
          <text x="50" y="60" font-family="Plus Jakarta Sans" font-size="22" font-weight="700" fill="#8B7A9E">ANTES · BEFORE</text>
        </svg>
      </div>

      <!-- Handle -->
      <div class="ba-handle" id="baHandle" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-label="Antes y después">
        <div class="ba-handle-line"></div>
        <div class="ba-handle-knob">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/><polyline points="9 18 15 12 9 6" style="transform: translateX(0)"/></svg>
        </div>
      </div>
    </div>

    <div class="ba-controls">
      <button class="ba-btn" data-ba="0"><span data-es>Antes</span><span data-en>Before</span></button>
      <button class="ba-btn" data-ba="50"><span data-es>Comparar</span><span data-en>Compare</span></button>
      <button class="ba-btn" data-ba="100"><span data-es>Después</span><span data-en>After</span></button>
    </div>
  </div>
</section>

<style>
  .ba-section {
    padding: var(--section-padding) 0;
    background: var(--white);
  }
  .ba-header { text-align: center; margin-bottom: 3.5rem; }
  .ba-header .section-subtitle { margin-inline: auto; }

  .ba-slider {
    position: relative;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    user-select: none;
    touch-action: none;
  }
  .ba-layer {
    position: absolute;
    inset: 0;
  }
  .ba-layer svg { width: 100%; height: 100%; display: block; }
  .ba-before {
    clip-path: inset(0 50% 0 0);
    transition: clip-path 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: clip-path;
  }
  .ba-slider.dragging .ba-before { transition: none; }

  .ba-handle {
    position: absolute;
    top: 0;
    left: 50%;
    bottom: 0;
    width: 4px;
    transform: translateX(-50%);
    pointer-events: auto;
    cursor: ew-resize;
    transition: left 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: left;
  }
  .ba-slider.dragging .ba-handle { transition: none; }

  .ba-handle-line {
    position: absolute;
    inset: 0;
    background: var(--white);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
  }
  .ba-handle-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px; height: 52px;
    background: var(--white);
    color: var(--pink-dark);
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(255, 177, 215, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--pink-light);
    transition: transform 0.2s;
  }
  .ba-handle:hover .ba-handle-knob { transform: translate(-50%, -50%) scale(1.1); }

  .ba-controls {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .ba-btn {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-full);
    background: var(--white);
    color: var(--pink-dark);
    border: 1.5px solid rgba(255, 177, 215, 0.25);
    transition: all var(--transition-fast);
  }
  .ba-btn:hover {
    background: var(--gradient-primary);
    color: var(--white);
    border-color: transparent;
    transform: translateY(-2px);
  }
</style>

<script>
  const slider = document.getElementById('baSlider');
  const before = document.getElementById('baBefore');
  const handle = document.getElementById('baHandle');
  if (slider && before && handle) {
    const setPos = (pct: number) => {
      const p = Math.max(0, Math.min(100, pct));
      (before as HTMLElement).style.clipPath = `inset(0 ${100 - p}% 0 0)`;
      (handle as HTMLElement).style.left = p + '%';
      handle.setAttribute('aria-valuenow', String(Math.round(p)));
    };

    let dragging = false;
    const onMove = (clientX: number) => {
      const r = slider.getBoundingClientRect();
      setPos(((clientX - r.left) / r.width) * 100);
    };
    const start = (e: PointerEvent) => {
      dragging = true;
      slider.classList.add('dragging');
      onMove(e.clientX);
      (e.target as HTMLElement).setPointerCapture?.(e.pointerId);
    };
    const move = (e: PointerEvent) => { if (dragging) onMove(e.clientX); };
    const end = () => { dragging = false; slider.classList.remove('dragging'); };

    slider.addEventListener('pointerdown', start);
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);

    document.querySelectorAll('.ba-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const v = parseFloat((btn as HTMLElement).dataset.ba || '50');
        setPos(v);
      });
    });

    setPos(50);
  }
</script>
