            <a href="mailto:hola@happydent-cancun.mx" data-hover>hola@happydent-cancun.mx</a>
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span data-es>Lun-Vie 9-18 · Sáb 9-14</span>
            <span data-en>Mon-Fri 9-18 · Sat 9-14</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Happy Dent Odontología · <span data-es>Cédulas Profesionales SEP registradas</span><span data-en>Licensed by SEP México</span></p>
      <p class="footer-love">
        <span data-es>Hecho con</span><span data-en>Made with</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#FFB1D7"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span data-es>para tu sonrisa</span><span data-en>for your smile</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--text-dark);
    padding: 4.5rem 0 0;
    position: relative;
    overflow: hidden;
  }
  .footer::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-primary);
  }
  .footer::after {
    content: '';
    position: absolute;
    top: 50%; left: 70%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(255, 177, 215, 0.06), transparent 60%);
    pointer-events: none;
  }
  .footer-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .footer-logo-icon { height: 44px; width: auto; filter: brightness(1.15); }
  .footer-name {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--pink);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .footer-tagline {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--lavender);
    margin-top: 4px;
    display: block;
  }
  .footer-desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 300px;
  }
  .footer-social { display: flex; gap: 0.7rem; }
  .footer-social a {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    color: rgba(255, 255, 255, 0.55);
    transition: all var(--transition-slow);
  }
  .footer-social a:hover {
    background: var(--gradient-primary);
    color: var(--white);
    transform: translateY(-3px);
  }
  .footer-links-group h4 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pink);
    margin-bottom: 1.25rem;
  }
  .footer-links-group ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-links-group li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.92rem;
  }
  .footer-links-group li svg { flex-shrink: 0; }
  .footer-links-group a {
    color: rgba(255, 255, 255, 0.5);
    transition: all var(--transition-fast);
  }
  .footer-links-group a:hover {
    color: var(--pink);
    padding-left: 4px;
  }
  .footer-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-bottom p {
    font-size: 0.83rem;
    color: rgba(255, 255, 255, 0.35);
  }
  .footer-love {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
