---
const base = import.meta.env.BASE_URL;
---

<!--
  ===== Intro reveal (autoplay) =====
  Pantalla completa con el SVG del diente. Al cargar la página:
   1) El diente entra y "respira".
   2) Se expande hasta cubrir y se desvanece.
   3) Se desbloquea el scroll y comienza la exploración.
-->
<div class="reveal-mask" id="revealMask" aria-hidden="true">
  <div class="reveal-mask-inner">
    <div class="reveal-shine"></div>
    <img src={`${base}happy-dent-icon.svg`} alt="" class="reveal-svg" />
    <span class="reveal-caption" id="revealCaption">
      <span data-es>Happy Dent · Cancún</span>
      <span data-en>Happy Dent · Cancún</span>
    </span>
  </div>
</div>

<section class="hero" id="inicio">
  <div class="hero-bg-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>
    <div class="shape shape-5"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span data-es>Dra. Dafne Mondragón · Dra. Cynthia Dzul</span>
        <span data-en>Dr. Dafne Mondragón · Dr. Cynthia Dzul</span>
      </div>

      <h1 class="hero-title">
        <span class="line">
          <span data-es>Tu sonrisa,</span>
          <span data-en>Your smile,</span>
        </span>
        <span class="line">
          <span data-es>nuestra <span class="highlight">obsesión</span>.</span>
          <span data-en>our <span class="highlight">obsession</span>.</span>
        </span>
      </h1>

      <p class="hero-description">
        <span data-es>
          Odontología estética premium en Cancún. Diseño de sonrisa, implantes de carga inmediata
          e Invisalign — con la calidez de un consultorio boutique y la precisión de la tecnología
          más avanzada del Caribe Mexicano.
        </span>
        <span data-en>
          Premium cosmetic dentistry in Cancún. Smile design, same-day implants and Invisalign —
          delivered in a boutique clinic with world-class technology.
        </span>
      </p>

      <div class="hero-ctas">
        <a href="#agenda" class="btn btn-primary" data-hover>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span data-es>Agendar mi cita</span><span data-en>Book my visit</span>
        </a>
        <a href="tel:+529983229592" class="btn btn-secondary" data-hover>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.36 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>(998) 322-9592</span>
        </a>
      </div>

      <div class="hero-stats glass">
        <div class="hero-stat">
          <span class="stat-number" data-count="500">0</span><span class="stat-plus">+</span>
          <span class="stat-label" data-es>Sonrisas felices</span><span class="stat-label" data-en>Happy smiles</span>
        </div>
        <div class="stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-number" data-count="8">0</span><span class="stat-plus">+</span>
          <span class="stat-label" data-es>Años de práctica</span><span class="stat-label" data-en>Years of practice</span>
        </div>
        <div class="stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-number" data-count="49" data-decimal="1">0</span><span class="stat-plus">★</span>
          <span class="stat-label" data-es>en Google</span><span class="stat-label" data-en>on Google</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-image-wrapper" id="heroVisual">
        <div class="hero-image-bg"></div>
        <div class="hero-image-content">
          <img src={`${base}happy-dent-icon.svg`} alt="Happy Dent — logotipo de la clínica dental" class="hero-tooth" />
        </div>

        <div class="floating-card card-1" data-hover>
          <div class="floating-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFB1D7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <div class="floating-card-text">
            <strong data-es>Diseño de sonrisa</strong><strong data-en>Smile design</strong>
            <span data-es>Tecnología 3D</span><span data-en>3D technology</span>
          </div>
        </div>

        <div class="floating-card card-2" data-hover>
          <div class="floating-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="#FFB1D7"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div class="floating-card-text">
            <strong data-es>Calificación</strong><strong data-en>Rating</strong>
            <span>4.9 / 5.0 · Google</span>
          </div>
        </div>

        <div class="floating-card card-3" data-hover>
          <div class="floating-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D8B9EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5c-2 0-4 2-4 4s2 6 4 10c2-4 4-8 4-10s-2-4-4-4z"/><path d="M8 12c-1-1-2.5 0-1.5 3s3.5 5 5.5 5 5-2 5.5-5 .5-4-1.5-3"/></svg>
          </div>
          <div class="floating-card-text">
            <strong data-es>Tecnología</strong><strong data-en>Technology</strong>
            <span data-es>Escáner 3D Itero</span><span data-en>3D Itero scanner</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-indicator">
    <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
    <span data-es>Comienza a explorar</span><span data-en>Start exploring</span>
  </div>
</section>

<style>
  /* ============ Intro reveal ============ */
  .reveal-mask {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--gradient-hero);
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: opacity, transform, clip-path;
    /* clip-path closes inward in the final phase */
    clip-path: circle(150% at 50% 50%);
  }
  .reveal-mask.done { pointer-events: none; }

  .reveal-mask-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .reveal-svg {
    width: clamp(140px, 22vw, 260px);
    height: auto;
    filter: drop-shadow(0 20px 60px rgba(255, 177, 215, 0.45));
    will-change: transform, opacity;
    transform-origin: 50% 50%;
  }

  .reveal-caption {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--pink-dark);
    opacity: 0;
    will-change: opacity, transform;
  }

  .reveal-shine {
    position: absolute;
    width: 160%;
    height: 160%;
    background: conic-gradient(from 0deg, transparent, rgba(255, 177, 215, 0.18), transparent 35%);
    animation: spin 14s linear infinite;
    pointer-events: none;
    opacity: 0.85;
    border-radius: 50%;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Body scroll-lock while intro plays */
  :global(body.intro-locked) {
    overflow: hidden !important;
    height: 100vh;
  }

  /* === Hero === */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: var(--gradient-hero);
    padding-top: 6rem;
    padding-bottom: 3rem;
  }

  .hero-bg-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.09;
    will-change: transform;
  }
  .shape-1 { width: 640px; height: 640px; background: var(--pink); top: -220px; right: -220px; }
  .shape-2 { width: 420px; height: 420px; background: var(--lavender); bottom: -120px; left: -120px; }
  .shape-3 { width: 220px; height: 220px; background: var(--pink); top: 50%; left: 30%; }
  .shape-4 { width: 170px; height: 170px; background: var(--lavender); top: 18%; right: 30%; }
  .shape-5 { width: 110px; height: 110px; background: var(--pink-medium); bottom: 28%; right: 10%; }

  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1.15rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 177, 215, 0.3);
    border-radius: var(--radius-full);
    backdrop-filter: blur(20px);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--pink-dark);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
  }
  .hero-title .line { display: block; }
  .hero-title .highlight {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 600;
  }

  .hero-description {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--text-medium);
    max-width: 560px;
    margin-bottom: 2rem;
    line-height: 1.75;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.8rem;
    border-radius: var(--radius-full);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all var(--transition-base);
    cursor: pointer;
    border: 1.5px solid transparent;
  }
  .btn-primary {
    background: var(--gradient-primary);
    color: var(--white);
    box-shadow: var(--shadow-md);
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .btn-secondary {
    background: rgba(255, 255, 255, 0.85);
    color: var(--pink-dark);
    border-color: rgba(255, 177, 215, 0.3);
    backdrop-filter: blur(10px);
  }
  .btn-secondary:hover {
    background: var(--white);
    border-color: var(--pink);
    transform: translateY(-3px);
  }
  .btn-white {
    background: var(--white);
    color: var(--pink-dark);
  }
  .btn-white:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

  .hero-stats {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.1rem 1.6rem;
    border-radius: var(--radius-lg);
  }
  .glass {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
  }
  .stat-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--pink-dark);
    line-height: 1;
    display: inline;
  }
  .stat-plus {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: var(--pink-dark);
    margin-left: 2px;
  }
  .stat-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.72rem;
    color: var(--text-light);
    margin-top: 4px;
    letter-spacing: 0.04em;
  }
  .stat-divider {
    width: 1px;
    height: 36px;
    background: linear-gradient(180deg, transparent, rgba(255, 177, 215, 0.4), transparent);
  }

  /* === Visual === */
  .hero-visual { position: relative; }
  .hero-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    max-width: 520px;
    margin: 0 auto;
  }
  .hero-image-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-primary);
    border-radius: 48% 52% 60% 40% / 55% 50% 50% 45%;
    opacity: 0.16;
    animation: morph 14s ease-in-out infinite alternate;
  }
  @keyframes morph {
    0%   { border-radius: 48% 52% 60% 40% / 55% 50% 50% 45%; }
    50%  { border-radius: 60% 40% 50% 50% / 40% 60% 40% 60%; }
    100% { border-radius: 40% 60% 45% 55% / 60% 40% 60% 40%; }
  }
  .hero-image-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-tooth {
    width: 78%;
    height: auto;
    filter: drop-shadow(0 20px 60px rgba(255, 177, 215, 0.35));
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50%      { transform: translateY(-12px) rotate(2deg); }
  }

  .floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.1rem;
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(20px);
  }
  .card-1 { top: 6%; left: -6%; animation: floatCard 7s ease-in-out infinite; }
  .card-2 { top: 42%; right: -8%; animation: floatCard 7s ease-in-out infinite 1.5s; }
  .card-3 { bottom: 6%; left: 4%; animation: floatCard 7s ease-in-out infinite 3s; }
  @keyframes floatCard {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }
  .floating-card-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, rgba(255,177,215,0.15), rgba(216,185,235,0.15));
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
  }
  .floating-card-text strong {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--text-dark);
  }
  .floating-card-text span {
    display: block;
    font-size: 0.72rem;
    color: var(--text-light);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    animation: bob 2.6s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, -8px); }
  }
  .scroll-mouse {
    width: 22px; height: 34px;
    border: 1.5px solid var(--text-muted);
    border-radius: 12px;
    position: relative;
  }
  .scroll-wheel {
    position: absolute;
    top: 6px; left: 50%;
    width: 3px; height: 6px;
    background: var(--text-muted);
    border-radius: 2px;
    transform: translateX(-50%);
    animation: wheel 1.6s ease-in-out infinite;
  }
  @keyframes wheel {
    0%   { transform: translate(-50%, 0); opacity: 1; }
    100% { transform: translate(-50%, 10px); opacity: 0; }
  }

  /* ============ Responsive ============ */
  @media (max-width: 980px) {
    .hero-container { grid-template-columns: 1fr; gap: 3rem; text-align: center; }
    .hero-badge, .hero-ctas, .hero-stats { margin-left: auto; margin-right: auto; }
    .hero-ctas { justify-content: center; }
    .hero-description { margin-left: auto; margin-right: auto; }
    .hero-image-wrapper { max-width: 380px; }
    .scroll-indicator { display: none; }
  }
  @media (max-width: 560px) {
    .hero-stats { flex-wrap: wrap; gap: 1rem 1.25rem; justify-content: center; }
    .stat-divider { display: none; }
    .card-1, .card-2, .card-3 { display: none; }
    .hero { padding-top: 5rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // ===== Intro: tooth opens fullscreen, then unlocks scroll =====
  document.body.classList.add('intro-locked');
  // Force scroll to top in case of refresh mid-page
  window.scrollTo(0, 0);

  const mask = document.getElementById('revealMask');
  const tooth = document.querySelector('.reveal-svg') as HTMLElement | null;
  const caption = document.getElementById('revealCaption');

  function unlock() {
    document.body.classList.remove('intro-locked');
    mask?.classList.add('done');
    if (mask) mask.style.display = 'none';
    // Notify the rest of the page that intro is finished
    document.dispatchEvent(new CustomEvent('intro:done'));
  }

  if (!mask || !tooth) {
    unlock();
  } else {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      onComplete: unlock,
    });
    // Phase 1: tooth eases in & breathes
    tl.from(tooth, { scale: 0.55, opacity: 0, duration: 0.9, ease: 'expo.out' })
      .to(tooth,   { scale: 1.08, duration: 0.5, ease: 'sine.inOut' })
      .to(tooth,   { scale: 1.00, duration: 0.4, ease: 'sine.inOut' });
    // Caption fade in/out
    if (caption) {
      tl.fromTo(caption,
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.5 }, '-=0.9')
        .to(caption, { opacity: 0, y: -10, duration: 0.4 }, '+=0.3');
    }
    // Phase 2: tooth scales up & fades; mask closes via clip-path
    tl.to(tooth, { scale: 7, opacity: 0, duration: 0.9, ease: 'power3.in' }, '+=0.05')
      .to(mask, { clipPath: 'circle(0% at 50% 50%)', duration: 0.7, ease: 'power3.inOut' }, '-=0.7');
  }

  // Safety net: never leave the page stuck locked
  setTimeout(() => {
    if (document.body.classList.contains('intro-locked')) unlock();
  }, 5000);
</script>
