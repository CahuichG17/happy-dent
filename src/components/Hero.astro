---
import { getCopy } from '../lib/copy';
const base = import.meta.env.BASE_URL;
const c = await getCopy();
---

<!-- Intro: el diente "abre" la página (una vez por sesión, se puede saltar) -->
<div class="reveal-mask" id="revealMask" aria-hidden="true">
  <div class="reveal-mask-inner">
    <img src={`${base}happy-dent-icon.svg`} alt="" class="reveal-svg" />
    <span class="reveal-caption" id="revealCaption">Happy Dent · Cancún</span>
  </div>
</div>

<section class="hero" id="inicio">
  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-badge">
        <span class="badge-rule" aria-hidden="true"></span>
        <span data-es>{c['hero.badge'].es}</span>
        <span data-en>{c['hero.badge'].en}</span>
      </p>

      <h1 class="hero-title">
        <span class="line">
          <span data-es>{c['hero.title1'].es}</span>
          <span data-en>{c['hero.title1'].en}</span>
        </span>
        <span class="line">
          <span data-es set:html={c['hero.title2'].es}></span>
          <span data-en set:html={c['hero.title2'].en}></span>
        </span>
      </h1>

      <p class="hero-description">
        <span data-es>{c['hero.description'].es}</span>
        <span data-en>{c['hero.description'].en}</span>
      </p>

      <div class="hero-ctas">
        <a href="/agendar" class="btn btn-primary">
          <span data-es>{c['hero.cta'].es}</span><span data-en>{c['hero.cta'].en}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="tel:+529983229592" class="btn btn-secondary">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.36 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>(998) 322-9592</span>
        </a>
      </div>

      <dl class="hero-stats">
        <div class="hero-stat">
          <dt class="stat-label" data-es>{c['hero.stat1'].es}</dt><dt class="stat-label" data-en>{c['hero.stat1'].en}</dt>
          <dd><span class="stat-number" data-count="500">500</span><span class="stat-plus">+</span></dd>
        </div>
        <div class="hero-stat">
          <dt class="stat-label" data-es>{c['hero.stat2'].es}</dt><dt class="stat-label" data-en>{c['hero.stat2'].en}</dt>
          <dd><span class="stat-number" data-count="8">8</span><span class="stat-plus">+</span></dd>
        </div>
        <div class="hero-stat">
          <dt class="stat-label" data-es>{c['hero.stat3'].es}</dt><dt class="stat-label" data-en>{c['hero.stat3'].en}</dt>
          <dd><span class="stat-number" data-count="49" data-decimal="1">4.9</span><span class="stat-plus">★</span></dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual" id="heroVisual">
      <div class="blob" aria-hidden="true"></div>

      <figure class="arch arch-main">
        <img src={`${base}dafne.webp`} alt="Dra. Dafne Mondragón" width="900" height="1194" fetchpriority="high" />
        <figcaption>Dra. Dafne Mondragón</figcaption>
      </figure>

      <figure class="arch arch-second">
        <img src={`${base}cynthia.webp`} alt="Dra. Cyntia Dzul" width="900" height="1155" loading="eager" />
        <figcaption>Dra. Cyntia Dzul</figcaption>
      </figure>

      <!-- Sello circular -->
      <div class="seal" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="sealPath" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"/></defs>
          <text><textPath href="#sealPath" startOffset="0">ODONTOLOGÍA ESTÉTICA · CANCÚN · MÉXICO ·</textPath></text>
        </svg>
        <img src={`${base}happy-dent-icon.svg`} alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  /* ============ Intro ============ */
  .reveal-mask {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: clip-path;
    clip-path: circle(150% at 50% 50%);
  }
  .reveal-mask.done { pointer-events: none; }
  .reveal-mask-inner { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .reveal-svg { width: clamp(130px, 20vw, 220px); height: auto; will-change: transform, opacity; }
  .reveal-caption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--text-light);
    opacity: 0;
  }
  :global(body.intro-locked) { overflow: hidden !important; height: 100vh; }

  /* ============ Hero ============ */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: var(--cream);
    padding: 7.5rem 0 4rem;
  }

  .hero-container {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-light);
    margin-bottom: 1.75rem;
  }
  .badge-rule { width: 36px; height: 1.5px; background: var(--pink-dark); flex-shrink: 0; }

  .hero-title {
    font-size: clamp(2.7rem, 5.5vw, 5.1rem);
    word-spacing: 0.08em;
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-bottom: 1.75rem;
  }
  .hero-title .line { display: block; }
  .hero-title :global(.highlight), .hero-title :global(em) {
    font-style: italic;
    font-weight: 400;
    color: var(--pink-dark);
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .hero-description {
    font-size: clamp(1.02rem, 1.25vw, 1.2rem);
    color: var(--text-medium);
    max-width: 520px;
    margin-bottom: 2.25rem;
    line-height: 1.75;
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-bottom: 3.25rem; }

  .hero-stats {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    max-width: 520px;
  }
  .hero-stat { display: flex; flex-direction: column-reverse; gap: 0.15rem; }
  .hero-stat dd { display: flex; align-items: baseline; gap: 0.1rem; }
  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.4vw, 2.9rem);
    font-weight: 500;
    line-height: 1;
    color: var(--text-dark);
  }
  .stat-plus { font-family: var(--font-display); font-size: 1.4rem; color: var(--pink-dark); }
  .stat-label { font-size: 0.82rem; color: var(--text-light); letter-spacing: 0.02em; }

  /* ---- Visual: dos arcos con fotos ---- */
  .hero-visual {
    position: relative;
    aspect-ratio: 1 / 1.08;
    width: 100%;
    max-width: 540px;
    justify-self: end;
  }
  .blob {
    position: absolute;
    inset: 6% 0 0 8%;
    background: var(--pink-light);
    border-radius: 58% 42% 55% 45% / 48% 55% 45% 52%;
  }
  .arch {
    position: absolute;
    margin: 0;
    overflow: hidden;
    background: var(--lavender-light);
    border-radius: 999px 999px 18px 18px;
  }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; }
  .arch figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2.5rem 1rem 0.85rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--white);
    background: linear-gradient(to top, rgba(43, 30, 42, 0.55), transparent);
  }
  .arch-main { top: 0; right: 4%; width: 62%; height: 80%; }
  .arch-second {
    bottom: 0; left: 0;
    width: 44%; height: 52%;
    border: 6px solid var(--cream);
    box-sizing: content-box;
    margin: 0 0 0 -6px;
  }

  .seal {
    position: absolute;
    left: 3%; top: 8%;
    width: 118px; height: 118px;
    border-radius: 50%;
    background: var(--pink-dark);
    color: var(--white);
    display: grid;
    place-items: center;
    animation: seal-spin 28s linear infinite;
  }
  .seal svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .seal text { font-family: var(--font-body); font-size: 9.4px; font-weight: 700; letter-spacing: 0.17em; fill: currentColor; }
  .seal img { width: 38px; filter: brightness(0) invert(1); animation: seal-spin 28s linear infinite reverse; }
  @keyframes seal-spin { to { transform: rotate(360deg); } }

  /* ============ Responsive ============ */
  @media (max-width: 960px) {
    .hero { padding-top: 6.5rem; }
    .hero-container { grid-template-columns: 1fr; gap: 3rem; }
    .hero-visual { justify-self: center; max-width: 440px; }
    .hero-stats { max-width: none; }
  }
  @media (max-width: 520px) {
    .hero-ctas .btn { width: 100%; }
    .seal { width: 92px; height: 92px; }
    .seal text { font-size: 9.6px; }
    .seal img { width: 30px; }
    .stat-label { font-size: 0.76rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .seal, .seal img { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // ===== Intro: tooth opens fullscreen, then unlocks scroll =====
  // Solo se muestra una vez por sesión, se omite con "reducir movimiento"
  // y el visitante puede saltarla con clic o tecla.
  let skipIntro = matchMedia('(prefers-reduced-motion: reduce)').matches;
  try {
    if (sessionStorage.getItem('hd-intro')) skipIntro = true;
    sessionStorage.setItem('hd-intro', '1');
  } catch {}
  if (!skipIntro) {
    document.body.classList.add('intro-locked');
    // Force scroll to top in case of refresh mid-page
    window.scrollTo(0, 0);
  }

  const mask = document.getElementById('revealMask');
  const tooth = document.querySelector('.reveal-svg') as HTMLElement | null;
  const caption = document.getElementById('revealCaption');

  let tlRef: gsap.core.Timeline | null = null;
  let unlocked = false;
  function unlock() {
    if (unlocked) return;
    unlocked = true;
    tlRef?.kill();
    document.body.classList.remove('intro-locked');
    mask?.classList.add('done');
    if (mask) mask.style.display = 'none';
    // Notify the rest of the page that intro is finished
    document.dispatchEvent(new CustomEvent('intro:done'));
  }

  if (skipIntro || !mask || !tooth) {
    unlock();
  } else {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      onComplete: unlock,
    });
    tlRef = tl;
    mask.addEventListener('click', unlock);
    window.addEventListener('keydown', unlock, { once: true });
    // Phase 1: tooth eases in & breathes
    tl.from(tooth, { scale: 0.55, opacity: 0, duration: 0.9, ease: 'expo.out' })
      .to(tooth,   { scale: 1.08, duration: 0.5, ease: 'sine.inOut' })
      .to(tooth,   { scale: 1.00, duration: 0.4, ease: 'sine.inOut' });
    // Caption fade in/out
    if (caption) {
      tl.fromTo(caption,
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.5 }, '-=0.9')
        .to(caption, { opacity: 0, y: -10, duration: 0.4 }, '+=0.3');
    }
    // Phase 2: tooth scales up & fades; mask closes via clip-path
    tl.to(tooth, { scale: 7, opacity: 0, duration: 0.9, ease: 'power3.in' }, '+=0.05')
      .to(mask, { clipPath: 'circle(0% at 50% 50%)', duration: 0.7, ease: 'power3.inOut' }, '-=0.7');
  }

  // Safety net: never leave the page stuck locked
  setTimeout(unlock, 5000);
</script>
