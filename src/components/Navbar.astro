---
const base = import.meta.env.BASE_URL;
---

<nav class="navbar" id="navbar">
  <div class="container nav-container">
    <a href="#inicio" class="nav-logo" data-hover>
      <img src={`${base}happy-dent-icon.svg`} alt="Happy Dent — Dentista en Cancún" class="logo-icon" />
      <div class="logo-text">
        <span class="logo-name">Happy Dent</span>
        <span class="logo-tagline" data-es>ODONTOLOGÍA · CANCÚN</span>
        <span class="logo-tagline" data-en>DENTISTRY · CANCÚN</span>
      </div>
    </a>

    <div class="nav-drawer" id="navDrawer">
      <ul class="nav-links">
        <li><a href="#inicio" class="nav-link active"><span data-es>Inicio</span><span data-en>Home</span></a></li>
        <li><a href="#servicios" class="nav-link"><span data-es>Servicios</span><span data-en>Services</span></a></li>
        <li><a href="#nosotros" class="nav-link"><span data-es>Nosotros</span><span data-en>About</span></a></li>
        <li><a href="#tourism" class="nav-link"><span data-es>Internacional</span><span data-en>International</span></a></li>
        <li><a href="#faq" class="nav-link">FAQ</a></li>
        <li><a href="#contacto" class="nav-link"><span data-es>Contacto</span><span data-en>Contact</span></a></li>
      </ul>

      <div class="nav-actions">
        <span class="nav-status" aria-live="polite">
          <span class="status-dot" id="statusDot"></span>
          <span id="statusText" data-es>Cargando…</span>
        </span>
        <button class="lang-toggle" data-lang-toggle aria-label="Cambiar idioma">EN</button>
        <a href="#agenda" class="btn-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span data-es>Agendar</span><span data-en>Book</span>
        </a>
      </div>
    </div>

    <!-- Lang toggle always visible on mobile (outside drawer) -->
    <button class="lang-toggle lang-toggle-mobile" data-lang-toggle aria-label="Cambiar idioma">EN</button>

    <button class="nav-toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 0.9rem 0;
    transition: padding var(--transition-base), background var(--transition-base), box-shadow var(--transition-base);
    background: transparent;
  }
  .navbar.scrolled {
    background: rgba(253, 245, 243, 0.82);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    box-shadow: 0 2px 30px rgba(255, 177, 215, 0.12);
    padding: 0.45rem 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    z-index: 1002;
    flex-shrink: 0;
  }
  .logo-icon { height: 42px; width: auto; transition: height var(--transition-base); }
  .navbar.scrolled .logo-icon { height: 36px; }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--pink-dark);
  }
  .logo-tagline {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--lavender-dark);
    margin-top: 3px;
  }

  /* ===== Desktop drawer (inline) ===== */
  .nav-drawer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-medium);
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--pink-dark);
    background: rgba(255, 177, 215, 0.1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .nav-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 177, 215, 0.2);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-medium);
    backdrop-filter: blur(10px);
    white-space: nowrap;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
    transition: all 0.3s;
  }
  .nav-status.open .status-dot {
    background: #10B981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.18);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  .nav-status.closed .status-dot { background: #EF4444; }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.18); }
    50%      { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0.04); }
  }

  .lang-toggle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--pink-dark);
    padding: 0.42rem 0.75rem;
    border: 1.5px solid rgba(255, 177, 215, 0.3);
    border-radius: var(--radius-full);
    background: transparent;
    transition: all var(--transition-fast);
  }
  .lang-toggle:hover {
    background: var(--pink);
    color: var(--white);
    border-color: var(--pink);
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
    color: var(--white);
    box-shadow: 0 4px 14px rgba(255, 177, 215, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
  }
  .btn-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255, 177, 215, 0.45); }

  /* ===== Lang toggle mobile (outside drawer) ===== */
  /* Hidden on desktop — the one inside nav-actions is used there */
  .lang-toggle-mobile {
    display: none;
    z-index: 1002;
  }

  /* ===== Hamburger ===== */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    z-index: 1002;
    padding: 8px;
    background: transparent;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--pink-dark);
    border-radius: 2px;
    transition: all var(--transition-base);
  }
  .nav-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .nav-toggle.active span:nth-child(2) { opacity: 0; }
  .nav-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  /* ===== Responsive ===== */

  /* Tablet: compact items, drop status indicator before hamburger appears */
  @media (max-width: 1180px) {
    .nav-link { padding: 0.45rem 0.6rem; font-size: 0.84rem; }
    .nav-drawer { gap: 1rem; }
    .nav-status { display: none; }
  }

  @media (max-width: 1024px) {
    .logo-tagline { display: none; }
  }

  /* Mobile: hamburger drawer */
  @media (max-width: 920px) {
    .nav-toggle { display: flex; }
    /* Show the always-visible lang toggle, hide the one buried in the drawer */
    .lang-toggle-mobile { display: flex; }
    .nav-actions .lang-toggle { display: none; }
    .nav-drawer {
      position: fixed;
      inset: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1.75rem;
      background: rgba(253, 245, 243, 0.98);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity var(--transition-base), transform var(--transition-base), visibility var(--transition-base);
      padding: 6rem 1.5rem 2.5rem;
      overflow-y: auto;
    }
    .nav-drawer.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .nav-links {
      flex-direction: column;
      gap: 0.5rem;
      width: 100%;
      max-width: 360px;
    }
    .nav-link {
      font-size: 1.05rem;
      padding: 0.85rem 1.5rem;
      width: 100%;
      text-align: center;
    }
    .nav-actions {
      flex-direction: column;
      gap: 0.85rem;
      width: 100%;
      max-width: 360px;
      align-items: stretch;
    }
    .nav-status {
      display: inline-flex;
      justify-content: center;
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
    }
    .lang-toggle, .btn-cta {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1.25rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 420px) {
    .logo-name { font-size: 1.2rem; }
    .logo-icon { height: 38px; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const navToggle = document.getElementById('navToggle');
  const navDrawer = document.getElementById('navDrawer');

  // Scrolled state
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) navbar?.classList.add('scrolled');
    else navbar?.classList.remove('scrolled');
  }, { passive: true });

  // Toggle drawer
  function closeMenu() {
    navToggle?.classList.remove('active');
    navDrawer?.classList.remove('active');
    navToggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  function openMenu() {
    navToggle?.classList.add('active');
    navDrawer?.classList.add('active');
    navToggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  navToggle?.addEventListener('click', () => {
    if (navDrawer?.classList.contains('active')) closeMenu();
    else openMenu();
  });
  navDrawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

  // Active link on scroll
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY + 110;
    sections.forEach(section => {
      const top = section.offsetTop;
      const height = section.offsetHeight;
      const id = section.getAttribute('id');
      if (!id) return;
      const link = document.querySelector(`.nav-link[href="#${id}"]`);
      if (scrollY >= top && scrollY < top + height) {
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        link?.classList.add('active');
      }
    });
  }, { passive: true });

  // ===== Open/closed schedule indicator =====
  // Schedule: Mon-Fri 9-18, Sat 9-14, Sun closed
  function scheduleNow() {
    const now = new Date();
    const day = now.getDay();
    const hour = now.getHours() + now.getMinutes() / 60;
    if (day === 0) return { open: false, nextEs: 'Lun 9:00', nextEn: 'Mon 9:00' };
    if (day === 6) {
      if (hour >= 9 && hour < 14) return { open: true, closesAt: '14:00' };
      return hour < 9
        ? { open: false, nextEs: 'Hoy 9:00', nextEn: 'Today 9:00' }
        : { open: false, nextEs: 'Lun 9:00', nextEn: 'Mon 9:00' };
    }
    if (hour >= 9 && hour < 18) return { open: true, closesAt: '18:00' };
    return hour < 9
      ? { open: false, nextEs: 'Hoy 9:00', nextEn: 'Today 9:00' }
      : { open: false, nextEs: 'Mañana 9:00', nextEn: 'Tomorrow 9:00' };
  }
  function renderStatus() {
    const wraps = document.querySelectorAll('.nav-status');
    const txt = document.getElementById('statusText');
    if (!txt) return;
    const s = scheduleNow();
    const lang = document.documentElement.getAttribute('data-lang') || 'es';
    wraps.forEach(w => {
      w.classList.remove('open', 'closed');
      w.classList.add(s.open ? 'open' : 'closed');
    });
    if (s.open) {
      txt.textContent = lang === 'es' ? `Abierto · cierra ${s.closesAt}` : `Open · closes ${s.closesAt}`;
    } else {
      txt.textContent = lang === 'es' ? `Cerrado · abre ${s.nextEs}` : `Closed · opens ${s.nextEn}`;
    }
  }
  renderStatus();
  setInterval(renderStatus, 60000);
  document.addEventListener('langchange', renderStatus);
</script>
