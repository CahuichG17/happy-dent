---
import { getServices } from '../lib/content';
const services = await getServices();
---

<section class="services" id="servicios">
  <div class="container">
    <div class="services-header">
      <span class="section-tag">
        <span data-es>Nuestros Servicios</span><span data-en>Our Services</span>
      </span>
      <h2 class="section-title">
        <span data-es>Tratamientos de<br/>excelencia dental</span>
        <span data-en>Treatments crafted<br/>with precision</span>
      </h2>
      <p class="section-subtitle">
        <span data-es>Tecnología de punta, especialistas certificados y un consultorio diseñado para que vuelvas siempre con una sonrisa.</span>
        <span data-en>Cutting-edge technology, board-certified specialists and a clinic designed to make you smile every visit.</span>
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card" data-hover>
          <div class="service-card-inner">
            <div class="service-icon" set:html={service.icon} />
            <h3 class="service-title">
              <span data-es>{service.title_es}</span>
              <span data-en>{service.title_en}</span>
            </h3>
            <p class="service-description">
              <span data-es>{service.desc_es}</span>
              <span data-en>{service.desc_en}</span>
            </p>
            <ul class="service-features">
              {service.features_es.map((feature, i) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span data-es>{feature}</span>
                  <span data-en>{service.features_en[i]}</span>
                </li>
              ))}
            </ul>
            <div class="service-footer">
              <a href={`https://wa.me/529983229592?text=${encodeURIComponent('Hola Happy Dent, quisiera información sobre ' + service.title_es)}`} target="_blank" rel="noopener" class="service-cta" data-hover>
                <span data-es>Solicitar información</span><span data-en>Request info</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
          <div class="service-card-glow"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--section-padding) 0;
    background: var(--white);
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--pink-light), var(--lavender-light), transparent);
  }

  .services-header {
    text-align: center;
    margin-bottom: 5rem;
  }
  .services-header .section-subtitle { margin-inline: auto; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .service-card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: transform var(--transition-slow);
    will-change: transform;
  }

  .service-card-inner {
    position: relative;
    z-index: 2;
    padding: 2.5rem;
    background: var(--gradient-card);
    border: 1px solid rgba(255, 177, 215, 0.12);
    border-radius: var(--radius-xl);
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-slow);
    backdrop-filter: blur(10px);
  }

  .service-card:hover .service-card-inner {
    border-color: rgba(255, 177, 215, 0.35);
    box-shadow: var(--shadow-lg);
    transform: translateY(-8px);
  }

  .service-card-glow {
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-xl);
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition-slow);
    z-index: 1;
  }
  .service-card:hover .service-card-glow { opacity: 0.1; }

  .service-icon {
    width: 60px; height: 60px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(255, 177, 215, 0.12), rgba(216, 185, 235, 0.12));
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    color: var(--pink-dark);
    transition: all var(--transition-slow);
  }
  .service-icon :global(svg) { width: 28px; height: 28px; }

  .service-card:hover .service-icon {
    background: var(--gradient-primary);
    color: var(--white);
    transform: scale(1.08) rotate(-4deg);
    box-shadow: 0 4px 15px rgba(255, 177, 215, 0.35);
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-dark);
    letter-spacing: -0.02em;
  }

  .service-description {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .service-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .service-features li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-medium);
    background: rgba(255, 177, 215, 0.08);
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
  }
  .service-features li svg { color: var(--pink); flex-shrink: 0; }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 177, 215, 0.12);
    gap: 1rem;
  }

  .service-price { display: flex; flex-direction: column; }
  .price-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .price-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--pink-dark);
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pink-dark);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(255, 177, 215, 0.1);
    transition: all var(--transition-fast);
  }
  .service-cta:hover {
    background: var(--gradient-primary);
    color: var(--white);
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
