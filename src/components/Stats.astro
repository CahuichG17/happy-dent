---
// Animated stat counters with milestones
---

<section class="stats-section" id="stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item" data-hover>
        <span class="stat-num" data-count="500">0</span><span class="stat-suffix">+</span>
        <span class="stat-name" data-es>Pacientes felices</span>
        <span class="stat-name" data-en>Happy patients</span>
      </div>
      <div class="stat-item" data-hover>
        <span class="stat-num" data-count="8">0</span><span class="stat-suffix">+</span>
        <span class="stat-name" data-es>Años de experiencia</span>
        <span class="stat-name" data-en>Years of experience</span>
      </div>
      <div class="stat-item" data-hover>
        <span class="stat-num" data-count="49" data-decimal="1">0</span><span class="stat-suffix">★</span>
        <span class="stat-name" data-es>en Google Reviews</span>
        <span class="stat-name" data-en>on Google Reviews</span>
      </div>
      <div class="stat-item" data-hover>
        <span class="stat-num" data-count="20">0</span><span class="stat-suffix">+</span>
        <span class="stat-name" data-es>Tratamientos disponibles</span>
        <span class="stat-name" data-en>Treatments available</span>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    background: var(--text-dark);
    color: var(--white);
    position: relative;
    overflow: hidden;
  }
  .stats-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top left, rgba(255, 177, 215, 0.15), transparent 60%),
      radial-gradient(ellipse at bottom right, rgba(216, 185, 235, 0.12), transparent 60%);
    pointer-events: none;
  }
  .stats-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    text-align: center;
  }
  .stat-item {
    padding: 2rem 1rem;
    border-radius: var(--radius-lg);
    transition: all var(--transition-slow);
    will-change: transform;
  }
  .stat-item:hover { transform: translateY(-6px); }
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
  }
  .stat-suffix {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--pink);
    font-weight: 700;
  }
  .stat-name {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.75rem;
    letter-spacing: 0.05em;
  }
</style>
