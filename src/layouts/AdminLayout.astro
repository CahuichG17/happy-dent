---
// Layout exclusivo del panel /admin. CSS totalmente aislado y autocontenido:
// NO importa nada del landing ni Tailwind global → el sitio público queda intacto.
interface Props {
  title?: string;
  active?: string;
}
const { title = 'Panel', active = '' } = Astro.props;
const user = Astro.locals.user;
const isSuper = user?.role === 'super_admin';

const nav = [
  { href: '/admin', label: 'Inicio', key: 'home', super: false, group: 'Clínica' },
  { href: '/admin/agenda', label: 'Agenda', key: 'agenda', super: false, group: 'Clínica' },
  { href: '/admin/pacientes', label: 'Pacientes', key: 'pacientes', super: false, group: 'Clínica' },
  { href: '/admin/citas', label: 'Citas', key: 'citas', super: false, group: 'Clínica' },
  { href: '/admin/horarios', label: 'Horarios', key: 'horarios', super: false, group: 'Clínica' },
  { href: '/admin/opiniones', label: 'Opiniones', key: 'opiniones', super: false, group: 'Clínica' },
  { href: '/admin/doctoras', label: 'Doctoras', key: 'doctoras', super: false, group: 'Sitio web' },
  { href: '/admin/servicios', label: 'Servicios', key: 'servicios', super: false, group: 'Sitio web' },
  { href: '/admin/testimonios', label: 'Testimonios', key: 'testimonios', super: false, group: 'Sitio web' },
  { href: '/admin/faq', label: 'Preguntas frecuentes', key: 'faq', super: false, group: 'Sitio web' },
  { href: '/admin/videos', label: 'Videos', key: 'videos', super: false, group: 'Sitio web' },
  { href: '/admin/textos', label: 'Textos del sitio', key: 'textos', super: false, group: 'Sitio web' },
  { href: '/admin/secciones', label: 'Secciones del sitio', key: 'secciones', super: false, group: 'Sitio web' },
  { href: '/admin/usuarios', label: 'Usuarios', key: 'usuarios', super: true, group: 'Sistema' },
  { href: '/admin/configuracion', label: 'Configuración', key: 'configuracion', super: true, group: 'Sistema' },
];
const visibleNav = nav.filter((i) => !i.super || isSuper);
const navGroups = [...new Set(visibleNav.map((i) => i.group))];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Happy Dent</title>
    <link rel="icon" type="image/svg+xml" href="/happy-dent.svg" />
  </head>
  <body>
    <div class="admin-shell">
      <header class="admin-topbar">
        <button type="button" class="admin-burger" id="adminBurger" aria-label="Abrir menú" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <div class="admin-brand">
          <img src="/happy-dent-icon.svg" alt="" width="24" height="24" />
          <span>Happy Dent</span>
        </div>
      </header>

      <div class="admin-backdrop" id="adminBackdrop" hidden></div>

      <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-brand admin-brand-desk">
          <img src="/happy-dent-icon.svg" alt="" width="28" height="28" />
          <span>Happy Dent</span>
        </div>
        <nav class="admin-nav">
          {navGroups.map((g) => (
            <div class="admin-nav-group">
              <p class="admin-nav-title">{g}</p>
              {visibleNav.filter((i) => i.group === g).map((i) => (
                <a href={i.href} class={`admin-nav-link${active === i.key ? ' is-active' : ''}`}>{i.label}</a>
              ))}
            </div>
          ))}
        </nav>
        <div class="admin-user">
          <div class="admin-user-info">
            <strong>{user?.name}</strong>
            <small>{isSuper ? 'Super admin' : 'Doctora'}</small>
          </div>
          <button type="button" id="logoutBtn" class="admin-logout">Salir</button>
        </div>
      </aside>
      <main class="admin-main">
        <slot />
      </main>
    </div>

    <script>
      import { signOut } from '../lib/auth/client';
      document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        await signOut();
        window.location.href = '/admin/login';
      });

      // Menú móvil (drawer)
      const sidebar = document.getElementById('adminSidebar');
      const backdrop = document.getElementById('adminBackdrop');
      const burger = document.getElementById('adminBurger');
      function openMenu() {
        sidebar?.classList.add('is-open');
        if (backdrop) backdrop.hidden = false;
        burger?.setAttribute('aria-expanded', 'true');
        document.body.classList.add('admin-no-scroll');
      }
      function closeMenu() {
        sidebar?.classList.remove('is-open');
        if (backdrop) backdrop.hidden = true;
        burger?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('admin-no-scroll');
      }
      burger?.addEventListener('click', () => {
        sidebar?.classList.contains('is-open') ? closeMenu() : openMenu();
      });
      backdrop?.addEventListener('click', closeMenu);
      sidebar?.querySelectorAll('.admin-nav-link').forEach((a) => a.addEventListener('click', closeMenu));
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

      // Uploader genérico: cualquier <input type="file" data-upload-input>
      // sube la imagen a /api/admin/upload, guarda la URL en el campo data-target
      // y muestra preview en data-preview.
      document.querySelectorAll('[data-upload-input]').forEach((el) => {
        const input = el as HTMLInputElement;
        input.addEventListener('change', async () => {
          const file = input.files && input.files[0];
          if (!file) return;
          const targetId = input.getAttribute('data-target') || '';
          const previewId = input.getAttribute('data-preview') || '';
          const status = input.parentElement?.querySelector('[data-upload-status]') as HTMLElement | null;
          const target = document.getElementById(targetId) as HTMLInputElement | null;
          const preview = previewId ? (document.getElementById(previewId) as HTMLImageElement | null) : null;

          if (status) status.textContent = 'Subiendo…';
          input.disabled = true;
          try {
            const fd = new FormData();
            fd.append('file', file);
            const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Error al subir');
            if (target) target.value = data.url;
            if (preview) {
              preview.src = data.url;
              preview.style.display = '';
            }
            if (status) status.textContent = 'Imagen lista';
          } catch (err) {
            if (status) status.textContent = (err as Error).message;
            input.value = '';
          } finally {
            input.disabled = false;
          }
        });
      });
    </script>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --a-pink: #FFB1D7;
        --a-pink-dark: #e87fb4;
        --a-ink: #1f2430;
        --a-muted: #6b7280;
        --a-line: #e7e9ee;
        --a-bg: #f6f7f9;
        --a-card: #ffffff;
        --a-radius: 12px;
      }
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--a-bg);
        color: var(--a-ink);
        -webkit-font-smoothing: antialiased;
      }
      .admin-shell { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; }
      .admin-topbar { display: none; }
      .admin-backdrop { display: none; }
      .admin-sidebar {
        background: var(--a-card);
        border-right: 1px solid var(--a-line);
        display: flex;
        flex-direction: column;
        padding: 1.25rem 1rem;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }
      .admin-brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.1rem; padding: 0.5rem; margin-bottom: 1rem; }
      .admin-nav { display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
      .admin-nav-group { display: flex; flex-direction: column; gap: 0.1rem; }
      .admin-nav-title { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--a-muted); font-weight: 700; padding: 0.5rem 0.75rem 0.25rem; }
      .admin-nav-link {
        display: block; padding: 0.6rem 0.75rem; border-radius: 9px;
        color: var(--a-muted); text-decoration: none; font-weight: 600; font-size: 0.92rem;
        transition: background 0.15s, color 0.15s;
      }
      .admin-nav-link:hover { background: var(--a-bg); color: var(--a-ink); }
      .admin-nav-link.is-active { background: var(--a-pink); color: #fff; }
      .admin-user { border-top: 1px solid var(--a-line); padding-top: 0.85rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
      .admin-user-info { display: flex; flex-direction: column; line-height: 1.2; }
      .admin-user-info strong { font-size: 0.88rem; }
      .admin-user-info small { color: var(--a-muted); font-size: 0.75rem; }
      .admin-logout { border: 1px solid var(--a-line); background: #fff; color: var(--a-ink); padding: 0.4rem 0.7rem; border-radius: 8px; font-weight: 600; font-size: 0.8rem; cursor: pointer; }
      .admin-logout:hover { background: var(--a-bg); }
      .admin-main { padding: 2rem 2.5rem; max-width: 1100px; width: 100%; }

      /* Componentes reutilizables del panel */
      .admin-h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.35rem; }
      .admin-sub { color: var(--a-muted); margin-bottom: 1.75rem; }
      .admin-card { background: var(--a-card); border: 1px solid var(--a-line); border-radius: var(--a-radius); padding: 1.25rem 1.4rem; margin-bottom: 1rem; }
      .admin-grid { display: grid; gap: 1rem; }
      .admin-btn { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--a-pink); color: #fff; border: none; padding: 0.6rem 1.1rem; border-radius: 9px; font-weight: 700; font-size: 0.9rem; cursor: pointer; text-decoration: none; transition: background 0.15s; }
      .admin-btn:hover { background: var(--a-pink-dark); }
      .admin-btn-ghost { background: #fff; color: var(--a-ink); border: 1px solid var(--a-line); }
      .admin-btn-ghost:hover { background: var(--a-bg); }
      .admin-btn-danger { background: #fee2e2; color: #b91c1c; }
      .admin-btn-danger:hover { background: #fecaca; }
      .admin-field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
      .admin-field label { font-weight: 600; font-size: 0.85rem; }
      .admin-field input, .admin-field textarea, .admin-field select {
        border: 1px solid var(--a-line); border-radius: 9px; padding: 0.6rem 0.75rem; font: inherit; font-size: 0.9rem; background: #fff; color: var(--a-ink); width: 100%;
      }
      .admin-field input:focus, .admin-field textarea:focus, .admin-field select:focus { outline: 2px solid var(--a-pink); outline-offset: 0; border-color: var(--a-pink); }
      .admin-field textarea { min-height: 90px; resize: vertical; }
      .admin-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .admin-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--a-line); border-radius: var(--a-radius); overflow: hidden; }
      .admin-table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--a-radius); }
      .admin-table th, .admin-table td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--a-line); font-size: 0.9rem; }
      .admin-table th { background: var(--a-bg); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--a-muted); }
      .admin-table tr:last-child td { border-bottom: none; }
      .admin-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .admin-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; gap: 1rem; }
      .admin-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
      .admin-badge.ok { background: #dcfce7; color: #166534; }
      .admin-badge.off { background: #f1f5f9; color: #64748b; }
      .admin-check { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; margin-bottom: 1rem; }
      .admin-check input { width: 1.05rem; height: 1.05rem; accent-color: var(--a-pink); }
      .admin-form-actions { display: flex; gap: 0.6rem; margin-top: 1rem; flex-wrap: wrap; }
      .uploader { display: flex; align-items: center; gap: 1rem; }
      .uploader-preview { width: 84px; height: 84px; object-fit: cover; border-radius: 12px; border: 1px solid var(--a-line); background: var(--a-bg); }
      .uploader-controls { display: flex; flex-direction: column; gap: 0.35rem; }
      .uploader-hint { font-size: 0.78rem; color: var(--a-muted); }
      .uploader input[type="file"] { font-size: 0.85rem; }
      @media (max-width: 900px) {
        .admin-shell { grid-template-columns: 1fr; }
        .admin-topbar {
          display: flex; align-items: center; gap: 0.75rem;
          position: sticky; top: 0; z-index: 40;
          background: var(--a-card); border-bottom: 1px solid var(--a-line);
          padding: 0.7rem 1rem;
        }
        .admin-topbar .admin-brand { margin: 0; padding: 0; font-size: 1rem; }
        .admin-brand-desk { display: none; }
        .admin-burger {
          width: 42px; height: 42px; border: 1px solid var(--a-line); background: #fff;
          border-radius: 10px; display: flex; flex-direction: column; align-items: center;
          justify-content: center; gap: 4px; cursor: pointer; flex: 0 0 auto;
        }
        .admin-burger span { width: 18px; height: 2px; background: var(--a-ink); border-radius: 2px; }
        .admin-backdrop {
          display: block; position: fixed; inset: 0; z-index: 49;
          background: rgba(15, 18, 28, 0.45);
        }
        .admin-backdrop[hidden] { display: none; }
        .admin-sidebar {
          position: fixed; top: 0; left: 0; z-index: 50;
          width: 82%; max-width: 300px; height: 100vh;
          transform: translateX(-100%);
          transition: transform 0.22s ease;
          box-shadow: 0 0 40px rgba(15, 18, 28, 0.18);
        }
        .admin-sidebar.is-open { transform: translateX(0); }
        .admin-main { padding: 1.25rem 1rem; max-width: 100%; }
        .admin-row { grid-template-columns: 1fr; }
        .admin-toolbar { flex-direction: column; align-items: stretch; }
        .admin-toolbar .admin-btn { width: 100%; justify-content: center; }
        .admin-h1 { font-size: 1.35rem; }
        :global(body.admin-no-scroll) { overflow: hidden; }
      }
      @media (max-width: 540px) {
        .admin-main { padding: 1rem 0.85rem; }
        .admin-card { padding: 1rem; }
        .admin-form-actions { flex-direction: column; }
        .admin-form-actions .admin-btn { width: 100%; justify-content: center; }
      }
      /* ─── Responsive card tables (≤580px) ─── */
      @media (max-width: 580px) {
        .admin-table-wrap { overflow: visible; border-radius: 0; }
        .admin-table { border: none; background: transparent; border-radius: 0; overflow: visible; }
        .admin-table thead { display: none; }
        .admin-table tbody { display: flex; flex-direction: column; gap: 0.65rem; }
        .admin-table tr { display: block; background: #fff; border: 1px solid var(--a-line); border-radius: 10px; overflow: hidden; }
        .admin-table tr:last-child td { border-bottom: 1px solid var(--a-line); }
        .admin-table td { display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--a-line); font-size: 0.88rem; }
        .admin-table td:last-child { border-bottom: none !important; }
        .admin-table td[data-label]::before {
          content: attr(data-label);
          font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
          letter-spacing: 0.04em; color: var(--a-muted);
          min-width: 5.5rem; flex-shrink: 0; padding-top: 0.12rem;
        }
        .admin-table td:not([data-label]) .admin-actions { gap: 0.35rem; width: 100%; }
        .admin-table td:not([data-label]) .admin-actions a,
        .admin-table td:not([data-label]) .admin-actions form { flex: 1 1 80px; }
        .admin-table td:not([data-label]) .admin-actions form .admin-btn,
        .admin-table td:not([data-label]) .admin-actions a.admin-btn { width: 100%; justify-content: center; }
        .admin-table td:not([data-label]) > a.admin-btn { width: 100%; justify-content: center; }
        .admin-actions { flex-wrap: wrap; }
      }
    </style>
  </body>
</html>
