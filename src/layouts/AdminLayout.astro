---
// Layout exclusivo del panel /admin. CSS totalmente aislado y autocontenido:
// NO importa nada del landing ni Tailwind global → el sitio público queda intacto.
interface Props {
  title?: string;
  active?: string;
}
const { title = 'Panel', active = '' } = Astro.props;
const user = Astro.locals.user;
const isSuper = user?.role === 'super_admin';

const nav = [
  { href: '/admin', label: 'Inicio', key: 'home', super: false },
  { href: '/admin/doctoras', label: 'Doctoras', key: 'doctoras', super: false },
  { href: '/admin/servicios', label: 'Servicios', key: 'servicios', super: false },
  { href: '/admin/testimonios', label: 'Testimonios', key: 'testimonios', super: false },
  { href: '/admin/faq', label: 'Preguntas frecuentes', key: 'faq', super: false },
  { href: '/admin/videos', label: 'Videos', key: 'videos', super: false },
  { href: '/admin/secciones', label: 'Secciones del sitio', key: 'secciones', super: false },
  { href: '/admin/citas', label: 'Citas', key: 'citas', super: false },
  { href: '/admin/horarios', label: 'Horarios', key: 'horarios', super: false },
  { href: '/admin/usuarios', label: 'Usuarios', key: 'usuarios', super: true },
  { href: '/admin/configuracion', label: 'Configuración', key: 'configuracion', super: true },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Happy Dent</title>
    <link rel="icon" type="image/svg+xml" href="/happy-dent.svg" />
  </head>
  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <div class="admin-brand">
          <img src="/happy-dent-icon.svg" alt="" width="28" height="28" />
          <span>Happy Dent</span>
        </div>
        <nav class="admin-nav">
          {nav.filter((i) => !i.super || isSuper).map((i) => (
            <a href={i.href} class={`admin-nav-link${active === i.key ? ' is-active' : ''}`}>{i.label}</a>
          ))}
        </nav>
        <div class="admin-user">
          <div class="admin-user-info">
            <strong>{user?.name}</strong>
            <small>{isSuper ? 'Super admin' : 'Doctora'}</small>
          </div>
          <button type="button" id="logoutBtn" class="admin-logout">Salir</button>
        </div>
      </aside>
      <main class="admin-main">
        <slot />
      </main>
    </div>

    <script>
      import { signOut } from '../lib/auth/client';
      document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        await signOut();
        window.location.href = '/admin/login';
      });

      // Uploader genérico: cualquier <input type="file" data-upload-input>
      // sube la imagen a /api/admin/upload, guarda la URL en el campo data-target
      // y muestra preview en data-preview.
      document.querySelectorAll('[data-upload-input]').forEach((el) => {
        const input = el as HTMLInputElement;
        input.addEventListener('change', async () => {
          const file = input.files && input.files[0];
          if (!file) return;
          const targetId = input.getAttribute('data-target') || '';
          const previewId = input.getAttribute('data-preview') || '';
          const status = input.parentElement?.querySelector('[data-upload-status]') as HTMLElement | null;
          const target = document.getElementById(targetId) as HTMLInputElement | null;
          const preview = previewId ? (document.getElementById(previewId) as HTMLImageElement | null) : null;

          if (status) status.textContent = 'Subiendo…';
          input.disabled = true;
          try {
            const fd = new FormData();
            fd.append('file', file);
            const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Error al subir');
            if (target) target.value = data.url;
            if (preview) {
              preview.src = data.url;
              preview.style.display = '';
            }
            if (status) status.textContent = 'Imagen lista';
          } catch (err) {
            if (status) status.textContent = (err as Error).message;
            input.value = '';
          } finally {
            input.disabled = false;
          }
        });
      });
    </script>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --a-pink: #FFB1D7;
        --a-pink-dark: #e87fb4;
        --a-ink: #1f2430;
        --a-muted: #6b7280;
        --a-line: #e7e9ee;
        --a-bg: #f6f7f9;
        --a-card: #ffffff;
        --a-radius: 12px;
      }
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--a-bg);
        color: var(--a-ink);
        -webkit-font-smoothing: antialiased;
      }
      .admin-shell { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; }
      .admin-sidebar {
        background: var(--a-card);
        border-right: 1px solid var(--a-line);
        display: flex;
        flex-direction: column;
        padding: 1.25rem 1rem;
        position: sticky;
        top: 0;
        height: 100vh;
      }
      .admin-brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.1rem; padding: 0.5rem; margin-bottom: 1rem; }
      .admin-nav { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; }
      .admin-nav-link {
        display: block; padding: 0.6rem 0.75rem; border-radius: 9px;
        color: var(--a-muted); text-decoration: none; font-weight: 600; font-size: 0.92rem;
        transition: background 0.15s, color 0.15s;
      }
      .admin-nav-link:hover { background: var(--a-bg); color: var(--a-ink); }
      .admin-nav-link.is-active { background: var(--a-pink); color: #fff; }
      .admin-user { border-top: 1px solid var(--a-line); padding-top: 0.85rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
      .admin-user-info { display: flex; flex-direction: column; line-height: 1.2; }
      .admin-user-info strong { font-size: 0.88rem; }
      .admin-user-info small { color: var(--a-muted); font-size: 0.75rem; }
      .admin-logout { border: 1px solid var(--a-line); background: #fff; color: var(--a-ink); padding: 0.4rem 0.7rem; border-radius: 8px; font-weight: 600; font-size: 0.8rem; cursor: pointer; }
      .admin-logout:hover { background: var(--a-bg); }
      .admin-main { padding: 2rem 2.5rem; max-width: 1100px; width: 100%; }

      /* Componentes reutilizables del panel */
      .admin-h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.35rem; }
      .admin-sub { color: var(--a-muted); margin-bottom: 1.75rem; }
      .admin-card { background: var(--a-card); border: 1px solid var(--a-line); border-radius: var(--a-radius); padding: 1.25rem 1.4rem; margin-bottom: 1rem; }
      .admin-grid { display: grid; gap: 1rem; }
      .admin-btn { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--a-pink); color: #fff; border: none; padding: 0.6rem 1.1rem; border-radius: 9px; font-weight: 700; font-size: 0.9rem; cursor: pointer; text-decoration: none; transition: background 0.15s; }
      .admin-btn:hover { background: var(--a-pink-dark); }
      .admin-btn-ghost { background: #fff; color: var(--a-ink); border: 1px solid var(--a-line); }
      .admin-btn-ghost:hover { background: var(--a-bg); }
      .admin-btn-danger { background: #fee2e2; color: #b91c1c; }
      .admin-btn-danger:hover { background: #fecaca; }
      .admin-field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
      .admin-field label { font-weight: 600; font-size: 0.85rem; }
      .admin-field input, .admin-field textarea, .admin-field select {
        border: 1px solid var(--a-line); border-radius: 9px; padding: 0.6rem 0.75rem; font: inherit; font-size: 0.9rem; background: #fff; color: var(--a-ink); width: 100%;
      }
      .admin-field input:focus, .admin-field textarea:focus, .admin-field select:focus { outline: 2px solid var(--a-pink); outline-offset: 0; border-color: var(--a-pink); }
      .admin-field textarea { min-height: 90px; resize: vertical; }
      .admin-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .admin-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--a-line); border-radius: var(--a-radius); overflow: hidden; }
      .admin-table th, .admin-table td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--a-line); font-size: 0.9rem; }
      .admin-table th { background: var(--a-bg); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--a-muted); }
      .admin-table tr:last-child td { border-bottom: none; }
      .admin-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .admin-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; gap: 1rem; }
      .admin-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
      .admin-badge.ok { background: #dcfce7; color: #166534; }
      .admin-badge.off { background: #f1f5f9; color: #64748b; }
      .admin-check { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; margin-bottom: 1rem; }
      .admin-check input { width: 1.05rem; height: 1.05rem; accent-color: var(--a-pink); }
      .admin-form-actions { display: flex; gap: 0.6rem; margin-top: 1rem; flex-wrap: wrap; }
      .uploader { display: flex; align-items: center; gap: 1rem; }
      .uploader-preview { width: 84px; height: 84px; object-fit: cover; border-radius: 12px; border: 1px solid var(--a-line); background: var(--a-bg); }
      .uploader-controls { display: flex; flex-direction: column; gap: 0.35rem; }
      .uploader-hint { font-size: 0.78rem; color: var(--a-muted); }
      .uploader input[type="file"] { font-size: 0.85rem; }
      @media (max-width: 820px) {
        .admin-shell { grid-template-columns: 1fr; }
        .admin-sidebar { position: static; height: auto; flex-direction: row; flex-wrap: wrap; }
        .admin-nav { flex-direction: row; flex-wrap: wrap; }
        .admin-main { padding: 1.5rem 1.25rem; }
        .admin-row { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
