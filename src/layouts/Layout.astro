---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Happy Dent Cancún | Dentistas — Estética Dental, Implantes e Invisalign",
  description = "Clínica dental boutique en Cancún. Diseño de sonrisa, implantes, ortodoncia invisible y odontología estética. Atención bilingüe — Dental Tourism. Agenda hoy.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = (Astro.site?.origin ?? "https://happy-dent-production.up.railway.app").replace(/\/$/, "");
// Los crawlers sociales (WhatsApp, Facebook, X) no soportan SVG: usar PNG.
const ogImage = `${siteUrl}${base}og-image.png`;

// Analytics: solo se cargan si hay un ID real configurado (variables PUBLIC_*).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || "";
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID || "";
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID || "";
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="dentista Cancún, dentista en Cancún, odontólogo Cancún, implantes dentales Cancún, ortodoncia invisible Cancún, blanqueamiento dental Cancún, diseño de sonrisa, dental tourism Cancun, dentist Cancun Mexico" />
    <meta name="author" content="Happy Dent — Cancún" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="MX-ROO" />
    <meta name="geo.placename" content="Cancún, Quintana Roo" />
    <meta name="geo.position" content="21.1619;-86.8515" />
    <meta name="ICBM" content="21.1619, -86.8515" />
    <link rel="canonical" href={`${siteUrl}${base}`} />
    <meta name="theme-color" content="#FBF6F0" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Happy Dent Cancún" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteUrl}${base}`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Happy Dent — Dentista en Cancún" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}happy-dent.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD: Dentist + LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Dentist", "LocalBusiness", "MedicalBusiness"],
      "name": "Happy Dent Cancún",
      "image": ogImage,
      "logo": `${siteUrl}${base}icon-512.png`,
      "url": `${siteUrl}${base}`,
      "telephone": "+52-998-322-9592",
      "email": "hola@happydent-cancun.mx",
      "currenciesAccepted": "MXN, USD",
      "paymentAccepted": "Cash, Credit Card, Debit Card, Bank Transfer",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Torre Métropoli",
        "addressLocality": "Cancún",
        "addressRegion": "Quintana Roo",
        "postalCode": "77500",
        "addressCountry": "MX"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 21.1583243,
        "longitude": -86.8279692
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/happydentodontologia",
        "https://www.instagram.com/happydentodontologia",
        "https://wa.me/529983229592"
      ],
      "medicalSpecialty": ["Dentistry", "CosmeticDentistry", "Orthodontics", "DentalImplants"],
      "areaServed": [
        { "@type": "City", "name": "Cancún" },
        { "@type": "AdministrativeArea", "name": "Riviera Maya" }
      ],
      "employee": [
        {
          "@type": "Person",
          "name": "Dra. Dafne Mondragón",
          "jobTitle": "Cirujana Dentista — Estética Dental y Ortodoncia"
        },
        {
          "@type": "Person",
          "name": "Dra. Cyntia Dzul",
          "jobTitle": "Cirujana Dentista — Endodoncia y Odontopediatría"
        }
      ]
    })} />

    <!-- Google Analytics 4 (solo si PUBLIC_GA4_ID está definido) -->
    {GA4_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>}
    {GA4_ID && <script is:inline define:vars={{ GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA4_ID, { anonymize_ip: true });
      window.gtag = gtag;
    </script>}

    <!-- Meta Pixel (solo si PUBLIC_META_PIXEL_ID está definido) -->
    {META_PIXEL_ID && <script is:inline define:vars={{ META_PIXEL_ID }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', META_PIXEL_ID);
      fbq('track', 'PageView');
    </script>}

    <!-- Microsoft Clarity (solo si PUBLIC_CLARITY_ID está definido) -->
    {CLARITY_ID && <script is:inline define:vars={{ CLARITY_ID }}>
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script", CLARITY_ID);
    </script>}
  </head>
  <body>
    <a href="#contenido" class="skip-link">
      <span data-es>Saltar al contenido</span><span data-en>Skip to content</span>
    </a>

    <!-- Progress bar -->
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

    <slot />

    <style is:global>
      :root {
        /* Paleta: papel cálido + rosa profundo + ciruela. El rosa de la marca
           (#FFB1D7) queda como acento suave; texto y botones usan tonos más
           profundos para tener buen contraste. */
        --pink-light: #F9E9E7;
        --pink: #F3C6D2;
        --pink-medium: #D9728F;
        --pink-dark: #B23A67;
        --lavender-light: #F1E8EF;
        --lavender: #D2BCD4;
        --lavender-medium: #A98BAF;
        --lavender-dark: #6E4F78;
        --cream: #FBF6F0;
        --cream-dark: #F3EADF;
        --white: #FFFFFF;
        --text-dark: #2B1E2A;
        --text-medium: #55444F;
        --text-light: #75626F;
        --text-muted: #9A8896;
        --line: rgba(43, 30, 42, 0.12);

        /* Sin degradados: se mantienen los nombres para no romper componentes. */
        --gradient-primary: var(--pink-dark);
        --gradient-soft: var(--cream-dark);
        --gradient-hero: var(--cream);
        --gradient-card: var(--white);

        --shadow-sm: 0 1px 2px rgba(43, 30, 42, 0.05);
        --shadow-md: 0 6px 18px rgba(43, 30, 42, 0.07);
        --shadow-lg: 0 14px 36px rgba(43, 30, 42, 0.09);
        --shadow-xl: 0 24px 56px rgba(43, 30, 42, 0.12);
        --shadow-glow: 0 0 0 transparent;

        --section-padding: clamp(4.5rem, 9vw, 8.5rem);
        --container-max: 1240px;
        --container-padding: clamp(1.25rem, 4vw, 3rem);

        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 18px;
        --radius-xl: 26px;
        --radius-full: 9999px;

        --font-display: 'Fraunces', Georgia, serif;
        --font-body: 'DM Sans', system-ui, sans-serif;

        --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-slow: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        font-family: var(--font-body);
        color: var(--text-dark);
        background-color: var(--cream);
        overflow-x: hidden;
        line-height: 1.7;
        font-size: 1.0625rem;
        position: relative;
      }

      /* Grano de papel muy sutil: quita lo "plano digital" */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        opacity: 0.35;
        mix-blend-mode: multiply;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .45  0 0 0 0 .35  0 0 0 0 .38  0 0 0 .09 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        font-weight: 500;
        line-height: 1.08;
        color: var(--text-dark);
        letter-spacing: -0.005em;
        word-spacing: 0.05em;
              }

      a { text-decoration: none; color: inherit; }
      img { max-width: 100%; height: auto; }
      ul, ol { list-style: none; }
      button { border: none; cursor: pointer; font-family: inherit; background: none; }

      .container {
        max-width: var(--container-max);
        margin: 0 auto;
        padding-inline: var(--container-padding);
      }

      /* Etiqueta de sección: texto + filete, sin "píldora" */
      .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pink-dark);
        background: none;
        padding: 0;
        border-radius: 0;
        margin-bottom: 1.25rem;
      }
      .section-tag::before {
        content: '';
        width: 28px;
        height: 1.5px;
        border-radius: 0;
        background: var(--pink-dark);
      }

      .section-title {
        font-size: clamp(2.2rem, 4.6vw, 3.6rem);
        font-weight: 500;
        margin-bottom: 1.25rem;
        letter-spacing: -0.01em;
        color: var(--text-dark);
        background: none;
        -webkit-text-fill-color: currentColor;
      }
      .section-title em, .section-title .highlight {
        font-style: italic;
        font-weight: 400;
        color: var(--pink-dark);
        background: none;
        -webkit-text-fill-color: currentColor;
      }

      .section-subtitle {
        font-size: clamp(1.02rem, 1.3vw, 1.15rem);
        color: var(--text-light);
        max-width: 580px;
        line-height: 1.75;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        font-family: var(--font-body);
        font-size: 0.98rem;
        font-weight: 600;
        padding: 0.95rem 1.8rem;
        border-radius: var(--radius-full);
        border: 1.5px solid transparent;
        transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
        position: relative;
      }

      .btn-primary {
        background: var(--pink-dark);
        color: var(--white);
        box-shadow: none;
      }
      .btn-primary:hover { background: #962D55; transform: translateY(-2px); box-shadow: none; }

      .btn-secondary {
        background: transparent;
        color: var(--text-dark);
        border: 1.5px solid var(--text-dark);
        box-shadow: none;
      }
      .btn-secondary:hover { background: var(--text-dark); color: var(--cream); border-color: var(--text-dark); transform: translateY(-2px); box-shadow: none; }

      .btn-whatsapp {
        background: #1FA855;
        color: var(--white);
        box-shadow: none;
      }
      .btn-whatsapp:hover { background: #178a45; transform: translateY(-2px); box-shadow: none; }

      .btn-facebook {
        background: #1877F2;
        color: var(--white);
        box-shadow: none;
      }
      .btn-facebook:hover { background: #0D5BC6; transform: translateY(-2px); box-shadow: none; }

      /* Antes "glass": ahora una tarjeta sólida con filete */
      .glass {
        background: var(--white);
        border: 1px solid var(--line);
        box-shadow: none;
      }

      /* === Accesibilidad === */
      .skip-link {
        position: fixed;
        top: 0.75rem; left: 0.75rem;
        z-index: 10000;
        padding: 0.7rem 1.2rem;
        border-radius: var(--radius-full);
        background: var(--text-dark);
        color: var(--white);
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 600;
        transform: translateY(-200%);
        transition: transform var(--transition-fast);
      }
      .skip-link:focus { transform: translateY(0); }

      :focus-visible {
        outline: 3px solid var(--pink-dark);
        outline-offset: 3px;
      }
      main:focus { outline: none; }

      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: var(--cream); }
      ::-webkit-scrollbar-thumb { background: var(--lavender); border-radius: var(--radius-full); }

      ::selection {
        background: var(--pink);
        color: var(--text-dark);
      }

      .scroll-progress {
        position: fixed;
        top: 0; left: 0;
        height: 2px;
        width: 0%;
        background: var(--pink-dark);
        z-index: 1001;
        transition: width 0.05s linear;
      }

      /* === i18n === */
      html[data-lang="en"] [data-es] { display: none !important; }
      html[data-lang="es"] [data-en] { display: none !important; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>

    <script>
      // === Scroll progress ===
      const progress = document.getElementById('scrollProgress');
      if (progress) {
        const onScroll = () => {
          const h = document.documentElement;
          const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
          progress.style.width = pct + '%';
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // === i18n toggle ===
      const setLang = (lang: string) => {
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);
        try { localStorage.setItem('hd-lang', lang); } catch {}
        document.querySelectorAll('[data-lang-toggle]').forEach(el => {
          (el as HTMLElement).textContent = lang === 'es' ? 'EN' : 'ES';
        });
        document.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
      };
      (window as any).hdSetLang = setLang;

      // Priority: 1) user's explicit saved choice, 2) browser/device language
      try {
        const saved = localStorage.getItem('hd-lang');
        if (saved === 'en' || saved === 'es') {
          setLang(saved);
        } else {
          // Detect from navigator: any Spanish variant → 'es', everything else → 'en'
          const browserLang = (navigator.language || navigator.languages?.[0] || 'es').toLowerCase();
          setLang(browserLang.startsWith('es') ? 'es' : 'en');
        }
      } catch {
        setLang('es');
      }

      document.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('[data-lang-toggle]');
        if (t) {
          const current = document.documentElement.getAttribute('data-lang') || 'es';
          setLang(current === 'es' ? 'en' : 'es');
        }
      });
    </script>
  </body>
</html>
