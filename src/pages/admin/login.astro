---
export const prerender = false;

// Si ya hay sesión, redirige al panel.
import { auth } from '../../lib/auth';
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (session) return Astro.redirect('/admin');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso · Happy Dent</title>
    <link rel="icon" type="image/svg+xml" href="/happy-dent.svg" />
  </head>
  <body>
    <main class="login-wrap">
      <form class="login-card" id="loginForm">
        <div class="login-brand">
          <img src="/happy-dent-icon.svg" alt="" width="40" height="40" />
          <h1>Happy Dent</h1>
          <p>Panel de administración</p>
        </div>
        <div class="login-field">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="login-field">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" />
        </div>
        <p class="login-error" id="loginError" hidden></p>
        <button type="submit" class="login-btn" id="loginBtn">Entrar</button>
      </form>
    </main>

    <script>
      import { signIn } from '../../lib/auth/client';
      const form = document.getElementById('loginForm') as HTMLFormElement;
      const errEl = document.getElementById('loginError') as HTMLParagraphElement;
      const btn = document.getElementById('loginBtn') as HTMLButtonElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errEl.hidden = true;
        btn.disabled = true;
        btn.textContent = 'Entrando…';
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;

        const { error } = await signIn.email({ email, password });

        if (error) {
          errEl.textContent = 'Correo o contraseña incorrectos.';
          errEl.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Entrar';
          return;
        }
        window.location.href = '/admin';
      });
    </script>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #fff0f7, #f3f0ff);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1f2430;
        padding: 1rem;
      }
      .login-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 20px 60px rgba(31, 36, 48, 0.12);
        padding: 2.25rem 2rem;
        width: 100%;
        max-width: 380px;
      }
      .login-brand { text-align: center; margin-bottom: 1.75rem; }
      .login-brand img { margin-bottom: 0.5rem; }
      .login-brand h1 { font-size: 1.4rem; font-weight: 800; }
      .login-brand p { color: #6b7280; font-size: 0.9rem; margin-top: 0.15rem; }
      .login-field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
      .login-field label { font-weight: 600; font-size: 0.85rem; }
      .login-field input { border: 1px solid #e7e9ee; border-radius: 10px; padding: 0.7rem 0.85rem; font: inherit; font-size: 0.95rem; }
      .login-field input:focus { outline: 2px solid #FFB1D7; border-color: #FFB1D7; }
      .login-error { color: #b91c1c; font-size: 0.85rem; margin-bottom: 0.75rem; }
      .login-btn { width: 100%; background: #FFB1D7; color: #fff; border: none; padding: 0.8rem; border-radius: 10px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: background 0.15s; }
      .login-btn:hover { background: #e87fb4; }
      .login-btn:disabled { opacity: 0.7; cursor: default; }
    </style>
  </body>
</html>
