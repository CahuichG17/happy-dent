---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { reviewTokens, doctors } from '../../../db/schema';
import { desc, eq, asc } from 'drizzle-orm';

const docList = await db.select({ id: doctors.id, name: doctors.name }).from(doctors).where(eq(doctors.active, true)).orderBy(asc(doctors.order));

const rows = await db
  .select({ t: reviewTokens, doctorName: doctors.name })
  .from(reviewTokens)
  .leftJoin(doctors, eq(reviewTokens.doctorId, doctors.id))
  .orderBy(desc(reviewTokens.createdAt))
  .limit(50);
---

<AdminLayout title="Opiniones" active="opiniones">
  <div class="admin-toolbar">
    <div>
      <h1 class="admin-h1">Opiniones</h1>
      <p class="admin-sub">Genera un enlace QR para que el paciente califique su consulta.</p>
    </div>
  </div>

  <div class="admin-card op-gen">
    <h2 class="op-gen-title">Generar nuevo enlace</h2>
    <form method="POST" action="/api/admin/opiniones" class="op-form">
      <div class="admin-field">
        <label for="patientName">Nombre del paciente</label>
        <input id="patientName" name="patientName" type="text" placeholder="Nombre completo" />
      </div>
      <div class="admin-field">
        <label for="doctorId">Doctora que atendio</label>
        <select id="doctorId" name="doctorId">
          <option value="">Sin especificar</option>
          {docList.map((d) => (
            <option value={d.id}>{d.name}</option>
          ))}
        </select>
      </div>
      <div class="admin-form-actions">
        <button type="submit" class="admin-btn">Generar enlace y QR</button>
      </div>
    </form>
  </div>

  <h2 class="op-h2">Historico de enlaces</h2>

  {rows.length === 0 ? (
    <div class="admin-card">No hay enlaces generados todavia.</div>
  ) : (
    <div class="admin-table-wrap"><table class="admin-table">
      <thead>
        <tr>
          <th>Paciente</th>
          <th>Doctora</th>
          <th>Creado</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ t, doctorName }) => {
          const expired = new Date(t.expiresAt) < new Date();
          const status = t.usedAt ? 'usado' : expired ? 'expirado' : 'activo';
          return (
            <tr>
              <td data-label="Paciente"><strong>{t.patientName || '—'}</strong></td>
              <td data-label="Doctora">{doctorName ?? '—'}</td>
              <td data-label="Creado">{t.createdAt.toLocaleDateString('es-MX')}</td>
              <td data-label="Estado">
                <span class={`admin-badge ${status === 'activo' ? 'ok' : 'off'}`}>{status}</span>
              </td>
              <td>
                <a href={`/admin/opiniones/${t.token}`} class="admin-btn admin-btn-ghost">Ver QR</a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table></div>
  )}

  <style>
    .op-gen-title { font-size: 1rem; font-weight: 800; margin-bottom: 1rem; }
    .op-form { display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end; }
    .op-form .admin-field { margin-bottom: 0; }
    .op-form .admin-form-actions { margin-top: 0; }
    .op-h2 { font-size: 1.1rem; font-weight: 800; margin: 1.5rem 0 0.85rem; }
    @media (max-width: 680px) { .op-form { grid-template-columns: 1fr; } }
  </style>
</AdminLayout>
