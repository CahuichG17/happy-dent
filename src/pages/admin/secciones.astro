---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSections } from '../../lib/content';

const sections = await getSections();

const LABELS: { key: string; label: string; desc: string }[] = [
  { key: 'stats', label: 'Estadísticas', desc: 'Barra de números (sonrisas, años, rating).' },
  { key: 'servicios', label: 'Servicios', desc: 'Tarjetas de tratamientos.' },
  { key: 'beforeafter', label: 'Antes y después', desc: 'Galería comparativa.' },
  { key: 'nosotros', label: 'Nosotros / Doctoras', desc: 'Equipo y certificaciones.' },
  { key: 'testimonios', label: 'Testimonios', desc: 'Reseñas de pacientes.' },
  { key: 'video', label: 'Video', desc: 'Recorrido por el consultorio.' },
  { key: 'insurance', label: 'Seguros / MSI', desc: 'Aseguradoras y meses sin intereses.' },
  { key: 'faq', label: 'Preguntas frecuentes', desc: 'Acordeón de dudas.' },
  { key: 'tourism', label: 'Turismo dental', desc: 'Sección para pacientes internacionales.' },
  { key: 'agenda', label: 'Agendar cita', desc: 'Formulario de solicitud de cita.' },
  { key: 'contacto', label: 'Contacto', desc: 'Datos y vías de contacto.' },
  { key: 'mapa', label: 'Mapa', desc: 'Ubicación del consultorio.' },
];
---

<AdminLayout title="Secciones" active="secciones">
  <div class="admin-toolbar">
    <div>
      <h1 class="admin-h1">Secciones del sitio</h1>
      <p class="admin-sub">Activa o desactiva qué secciones se muestran en la página principal. El encabezado y el pie siempre se mantienen.</p>
    </div>
  </div>

  <form method="POST" action="/api/admin/secciones" class="admin-card">
    <div class="sections-grid">
      {LABELS.map((s) => (
        <label class="section-toggle">
          <input type="checkbox" name={s.key} checked={sections[s.key]} />
          <span class="section-toggle-text">
            <strong>{s.label}</strong>
            <small>{s.desc}</small>
          </span>
        </label>
      ))}
    </div>

    <div class="admin-form-actions">
      <button type="submit" class="admin-btn">Guardar cambios</button>
      <a href="/" target="_blank" class="admin-btn admin-btn-ghost">Ver el sitio ↗</a>
    </div>
  </form>

  <style>
    .sections-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }
    .section-toggle { display: flex; align-items: flex-start; gap: 0.7rem; padding: 0.85rem 1rem; border: 1px solid var(--a-line); border-radius: 10px; cursor: pointer; background: #fff; transition: border-color 0.15s, background 0.15s; }
    .section-toggle:hover { border-color: var(--a-pink); background: var(--a-bg); }
    .section-toggle input { width: 1.15rem; height: 1.15rem; margin-top: 0.15rem; accent-color: var(--a-pink); flex-shrink: 0; }
    .section-toggle-text { display: flex; flex-direction: column; gap: 0.15rem; }
    .section-toggle-text strong { font-size: 0.92rem; }
    .section-toggle-text small { color: var(--a-muted); font-size: 0.78rem; }
    @media (max-width: 820px) { .sections-grid { grid-template-columns: 1fr; } }
  </style>
</AdminLayout>
