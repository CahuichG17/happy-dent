---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { testimonials } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
const isNew = id === 'nuevo';

let row: typeof testimonials.$inferSelect | null = null;
if (!isNew) {
  const numId = Number(id);
  if (Number.isNaN(numId)) return Astro.redirect('/admin/testimonios');
  const found = await db.select().from(testimonials).where(eq(testimonials.id, numId)).limit(1);
  row = found[0] ?? null;
  if (!row) return Astro.redirect('/admin/testimonios');
}
---

<AdminLayout title={isNew ? 'Nuevo testimonio' : 'Editar testimonio'} active="testimonios">
  <div class="admin-toolbar">
    <div>
      <h1 class="admin-h1">{isNew ? 'Nuevo testimonio' : 'Editar testimonio'}</h1>
      <p class="admin-sub">Los textos ES/EN se muestran según el idioma del sitio.</p>
    </div>
    <a href="/admin/testimonios" class="admin-btn admin-btn-ghost">← Volver</a>
  </div>

  <form method="POST" action="/api/admin/testimonios" class="admin-card">
    {!isNew && <input type="hidden" name="id" value={row!.id} />}

    <div class="admin-row">
      <div class="admin-field">
        <label for="name">Nombre del paciente</label>
        <input id="name" name="name" type="text" required value={row?.name ?? ''} />
      </div>
      <div class="admin-field">
        <label for="rating">Calificación (1-5)</label>
        <input id="rating" name="rating" type="number" min="1" max="5" value={row?.rating ?? 5} />
      </div>
    </div>

    <div class="admin-row">
      <div class="admin-field">
        <label for="roleEs">Rol / contexto (ES)</label>
        <input id="roleEs" name="roleEs" type="text" value={row?.roleEs ?? ''} placeholder="Paciente de Invisalign" />
      </div>
      <div class="admin-field">
        <label for="roleEn">Rol / contexto (EN)</label>
        <input id="roleEn" name="roleEn" type="text" value={row?.roleEn ?? ''} />
      </div>
    </div>

    <div class="admin-row">
      <div class="admin-field">
        <label for="textEs">Testimonio (ES)</label>
        <textarea id="textEs" name="textEs" rows="4">{row?.textEs ?? ''}</textarea>
      </div>
      <div class="admin-field">
        <label for="textEn">Testimonio (EN)</label>
        <textarea id="textEn" name="textEn" rows="4">{row?.textEn ?? ''}</textarea>
      </div>
    </div>

    <div class="admin-row">
      <div class="admin-field">
        <label for="avatar">Avatar (opcional)</label>
        <input id="avatar" name="avatar" type="text" value={row?.avatar ?? ''} placeholder="/avatar.jpg" />
      </div>
      <div class="admin-field">
        <label for="order">Orden</label>
        <input id="order" name="order" type="number" value={row?.order ?? 0} />
      </div>
    </div>

    <label class="admin-check">
      <input type="checkbox" name="approved" checked={row ? row.approved : true} />
      <span>Visible en el sitio</span>
    </label>

    <div class="admin-form-actions">
      <button type="submit" class="admin-btn">{isNew ? 'Crear testimonio' : 'Guardar cambios'}</button>
      <a href="/admin/testimonios" class="admin-btn admin-btn-ghost">Cancelar</a>
    </div>
  </form>
</AdminLayout>
