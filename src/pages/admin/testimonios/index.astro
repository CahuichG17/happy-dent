---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { testimonials } from '../../../db/schema';
import { asc } from 'drizzle-orm';

const rows = await db.select().from(testimonials).orderBy(asc(testimonials.order), asc(testimonials.id));
---

<AdminLayout title="Testimonios" active="testimonios">
  <div class="admin-toolbar">
    <div>
      <h1 class="admin-h1">Testimonios</h1>
      <p class="admin-sub">Reseñas de pacientes que se muestran en el sitio.</p>
    </div>
    <a href="/admin/testimonios/nuevo" class="admin-btn">+ Nuevo testimonio</a>
  </div>

  {rows.length === 0 ? (
    <div class="admin-card">Aún no hay testimonios.</div>
  ) : (
    <div class="admin-table-wrap"><table class="admin-table">
      <thead>
        <tr><th>Paciente</th><th>Calificación</th><th>Estado</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        {rows.map((t) => (
          <tr>
            <td data-label="Paciente"><strong>{t.name}</strong></td>
            <td data-label="Calif.">{'★'.repeat(t.rating)}</td>
            <td data-label="Estado">{t.approved ? <span class="admin-badge ok">Visible</span> : <span class="admin-badge off">Pendiente</span>}</td>
            <td>
              <div class="admin-actions">
                {!t.approved && (
                  <form method="POST" action="/api/admin/testimonios">
                    <input type="hidden" name="_action" value="approve" />
                    <input type="hidden" name="id" value={t.id} />
                    <button type="submit" class="admin-btn">Aprobar</button>
                  </form>
                )}
                <a href={`/admin/testimonios/${t.id}`} class="admin-btn admin-btn-ghost">Editar</a>
                <form method="POST" action="/api/admin/testimonios" onsubmit="return confirm('¿Eliminar este testimonio?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={t.id} />
                  <button type="submit" class="admin-btn admin-btn-danger">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table></div>
  )}
</AdminLayout>
