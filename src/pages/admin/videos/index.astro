---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db';
import { videos } from '../../../db/schema';
import { asc } from 'drizzle-orm';

const rows = await db.select().from(videos).orderBy(asc(videos.order), asc(videos.id));
---

<AdminLayout title="Videos" active="videos">
  <div class="admin-toolbar">
    <div>
      <h1 class="admin-h1">Videos</h1>
      <p class="admin-sub">Pega enlaces de YouTube, Facebook o Instagram para la galería.</p>
    </div>
    <a href="/admin/videos/nuevo" class="admin-btn">+ Nuevo video</a>
  </div>

  {rows.length === 0 ? (
    <div class="admin-card">Aún no hay videos. Agrega el primero.</div>
  ) : (
    <div class="admin-table-wrap"><table class="admin-table">
      <thead>
        <tr><th>Título</th><th>Plataforma</th><th>Estado</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        {rows.map((v) => (
          <tr>
            <td><strong>{v.title || '(sin título)'}</strong></td>
            <td><span class="admin-badge">{v.platform}</span></td>
            <td>{v.active ? <span class="admin-badge ok">Visible</span> : <span class="admin-badge off">Oculto</span>}</td>
            <td>
              <div class="admin-actions">
                <a href={`/admin/videos/${v.id}`} class="admin-btn admin-btn-ghost">Editar</a>
                <form method="POST" action="/api/admin/videos" onsubmit="return confirm('¿Eliminar este video?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={v.id} />
                  <button type="submit" class="admin-btn admin-btn-danger">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table></div>
  )}
</AdminLayout>
