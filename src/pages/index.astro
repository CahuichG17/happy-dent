---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Services from '../components/Services.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoSection from '../components/VideoSection.astro';
import Insurance from '../components/Insurance.astro';
import FAQ from '../components/FAQ.astro';
import DentalTourism from '../components/DentalTourism.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import Contact from '../components/Contact.astro';
import MapSection from '../components/MapSection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Stats />
    <Services />
    <BeforeAfter />
    <About />
    <Testimonials />
    <VideoSection />
    <Insurance />
    <FAQ />
    <DentalTourism />
    <AppointmentForm />
    <Contact />
    <MapSection />
  </main>
  <Footer />
  <WhatsAppFloat />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    gsap.defaults({ ease: 'power4.out', duration: 1 });

    // Wait until intro animation in Hero finishes before starting hero TL.
    // The Hero dispatches `intro:done` on document. Otherwise we run immediately.
    function startHeroTimeline() {
      const heroTl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      heroTl
        .from('.navbar', { y: -30, opacity: 0, duration: 0.9 }, 0)
        .from('.hero-badge', { y: 30, opacity: 0, duration: 0.9 }, 0.1)
        .from('.hero-title .line', { y: 60, opacity: 0, stagger: 0.12, duration: 1.2 }, '-=0.5')
        .from('.hero-description', { y: 24, opacity: 0, duration: 0.9 }, '-=0.7')
        .from('.hero-ctas > *', { y: 24, opacity: 0, stagger: 0.1, duration: 0.7 }, '-=0.5')
        .from('.hero-stats .hero-stat', { y: 24, opacity: 0, stagger: 0.1, duration: 0.7 }, '-=0.5')
        .from('.hero-visual', { x: 60, opacity: 0, duration: 1.1 }, '-=1.1')
        .from('.floating-card', { scale: 0.7, opacity: 0, stagger: 0.12, duration: 0.6, ease: 'back.out(1.6)' }, '-=0.6')
        .from('.scroll-indicator', { y: 14, opacity: 0, duration: 0.5 }, '-=0.2');

      // Hero stat counters
      gsap.utils.toArray<HTMLElement>('.hero-stat [data-count]').forEach(el => {
        const target = parseFloat(el.dataset.count || '0');
        const decimal = el.dataset.decimal === '1';
        const obj = { val: 0 };
        gsap.to(obj, {
          val: target,
          duration: 1.8,
          ease: 'power3.out',
          delay: 0.6,
          onUpdate: () => {
            el.textContent = decimal
              ? (obj.val / 10).toFixed(1)
              : Math.round(obj.val).toString();
          },
        });
      });
    }

    if (document.body.classList.contains('intro-locked')) {
      document.addEventListener('intro:done', startHeroTimeline, { once: true });
    } else {
      startHeroTimeline();
    }

    // Parallax shapes (subtle, smooth)
    gsap.utils.toArray<HTMLElement>('.shape').forEach((shape, i) => {
      gsap.to(shape, {
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.5 },
        y: -120 - i * 30,
        rotation: i * 10,
        ease: 'none',
      });
    });

    // ===== Universal section headers fade-up =====
    const fadeUp = (selector: string, opts: any = {}) => {
      gsap.utils.toArray<HTMLElement>(selector).forEach((el) => {
        gsap.from(el, {
          scrollTrigger: { trigger: el, start: opts.start || 'top 88%', toggleActions: 'play none none none' },
          y: opts.y ?? 40,
          opacity: 0,
          duration: opts.duration ?? 1,
          ease: 'power4.out',
        });
      });
    };
    fadeUp('.section-tag', { y: 16, duration: 0.7 });
    fadeUp('.section-title', { y: 40, duration: 1.1 });
    fadeUp('.section-subtitle', { y: 20, duration: 0.9 });

    // ===== Stats counters =====
    gsap.utils.toArray<HTMLElement>('.stats-grid .stat-item').forEach((item, i) => {
      gsap.from(item, {
        scrollTrigger: { trigger: '.stats-grid', start: 'top 82%' },
        y: 50, opacity: 0, duration: 0.9, delay: i * 0.1,
      });
    });
    gsap.utils.toArray<HTMLElement>('.stats-grid .stat-num').forEach(el => {
      const target = parseFloat(el.dataset.count || '0');
      const decimal = el.dataset.decimal === '1';
      const obj = { val: 0 };
      gsap.to(obj, {
        scrollTrigger: { trigger: el, start: 'top 88%' },
        val: target,
        duration: 2.2,
        ease: 'power3.out',
        onUpdate: () => {
          el.textContent = decimal
            ? (obj.val / 10).toFixed(1)
            : Math.round(obj.val).toString();
        },
      });
    });

    // ===== Services =====
    gsap.utils.toArray<HTMLElement>('.service-card').forEach((card, i) => {
      gsap.from(card, {
        scrollTrigger: { trigger: card, start: 'top 90%' },
        y: 60, opacity: 0, scale: 0.97,
        duration: 1, delay: (i % 3) * 0.1,
      });
    });
    document.querySelectorAll('.service-card').forEach(card => {
      const icon = card.querySelector('.service-icon');
      card.addEventListener('mouseenter', () => icon && gsap.to(icon, { scale: 1.12, rotation: -5, duration: 0.5, ease: 'expo.out' }));
      card.addEventListener('mouseleave', () => icon && gsap.to(icon, { scale: 1, rotation: 0, duration: 0.5, ease: 'expo.out' }));
    });

    // ===== Before/After =====
    gsap.from('.ba-slider', {
      scrollTrigger: { trigger: '.ba-slider', start: 'top 82%' },
      y: 50, scale: 0.96, opacity: 0, duration: 1.2, ease: 'expo.out',
    });

    // ===== About =====
    gsap.utils.toArray<HTMLElement>('.doctor-card').forEach((c, i) => {
      gsap.from(c, {
        scrollTrigger: { trigger: '.doctors-grid', start: 'top 82%' },
        y: 50, opacity: 0, scale: 0.97,
        duration: 1, delay: i * 0.15, ease: 'expo.out',
      });
    });
    gsap.utils.toArray<HTMLElement>('.about-feature').forEach((f, i) => {
      gsap.from(f, {
        scrollTrigger: { trigger: f, start: 'top 92%' },
        y: 30, opacity: 0, duration: 0.8, delay: i * 0.08,
      });
    });
    gsap.utils.toArray<HTMLElement>('.cert-chip').forEach((b, i) => {
      gsap.from(b, {
        scrollTrigger: { trigger: '.cert-row', start: 'top 92%' },
        y: 20, opacity: 0, duration: 0.6, delay: i * 0.06,
      });
    });

    // ===== Testimonials =====
    gsap.utils.toArray<HTMLElement>('.testimonial-card').forEach((card, i) => {
      gsap.from(card, {
        scrollTrigger: { trigger: card, start: 'top 90%' },
        y: 50, opacity: 0,
        duration: 0.9, delay: (i % 3) * 0.1,
      });
    });

    // ===== Video =====
    gsap.from('.video-wrapper', {
      scrollTrigger: { trigger: '.video-wrapper', start: 'top 82%' },
      scale: 0.94, opacity: 0, duration: 1.2, ease: 'expo.out',
    });

    // ===== Insurance =====
    gsap.utils.toArray<HTMLElement>('.ins-card').forEach((chip, i) => {
      gsap.from(chip, {
        scrollTrigger: { trigger: '.ins-grid', start: 'top 88%' },
        y: 20, opacity: 0, scale: 0.9,
        duration: 0.55, delay: i * 0.05, ease: 'back.out(1.4)',
      });
    });
    gsap.from('.pay-banner', {
      scrollTrigger: { trigger: '.pay-banner', start: 'top 88%' },
      y: 40, opacity: 0, duration: 1, ease: 'expo.out',
    });
    gsap.utils.toArray<HTMLElement>('.msi-chip').forEach((c, i) => {
      gsap.from(c, {
        scrollTrigger: { trigger: '.msi-chips', start: 'top 92%' },
        scale: 0.6, opacity: 0, duration: 0.6, delay: 0.2 + i * 0.08, ease: 'back.out(1.8)',
      });
    });
    gsap.utils.toArray<HTMLElement>('.card-tile').forEach((c, i) => {
      gsap.from(c, {
        scrollTrigger: { trigger: '.cards-row', start: 'top 92%' },
        y: 20, opacity: 0, duration: 0.6, delay: i * 0.07,
      });
    });

    // ===== FAQ =====
    gsap.utils.toArray<HTMLElement>('.faq-item').forEach((item, i) => {
      gsap.from(item, {
        scrollTrigger: { trigger: item, start: 'top 92%' },
        x: -24, opacity: 0, duration: 0.7, delay: i * 0.05,
      });
    });

    // ===== Dental tourism =====
    gsap.utils.toArray<HTMLElement>('.include-card').forEach((c, i) => {
      gsap.from(c, {
        scrollTrigger: { trigger: '.tourism-includes', start: 'top 86%' },
        y: 40, opacity: 0, duration: 0.8, delay: i * 0.1,
      });
    });
    gsap.utils.toArray<HTMLElement>('.intl-card').forEach((c, i) => {
      gsap.from(c, {
        scrollTrigger: { trigger: '.intl-grid', start: 'top 86%' },
        y: 30, opacity: 0, duration: 0.8, delay: i * 0.1,
      });
    });

    // ===== Appointment form =====
    gsap.from('.agenda-form', {
      scrollTrigger: { trigger: '.agenda-form', start: 'top 84%' },
      y: 50, opacity: 0, duration: 1.1, ease: 'expo.out',
    });
    gsap.from('.agenda-form .field', {
      scrollTrigger: { trigger: '.agenda-form', start: 'top 80%' },
      y: 20, opacity: 0, stagger: 0.07, duration: 0.7, delay: 0.3,
    });

    // ===== Contact =====
    gsap.from('.contact-info', {
      scrollTrigger: { trigger: '.contact-grid', start: 'top 80%' },
      x: -40, opacity: 0, duration: 1, ease: 'expo.out',
    });
    gsap.from('.contact-cta-area', {
      scrollTrigger: { trigger: '.contact-grid', start: 'top 80%' },
      x: 40, opacity: 0, duration: 1, ease: 'expo.out',
    });
    gsap.utils.toArray<HTMLElement>('.contact-method').forEach((m, i) => {
      gsap.from(m, {
        scrollTrigger: { trigger: m, start: 'top 92%' },
        x: -24, opacity: 0, duration: 0.7, delay: i * 0.1,
      });
    });

    // ===== Map =====
    gsap.from('.map-info', {
      scrollTrigger: { trigger: '.map-grid', start: 'top 82%' },
      x: -40, opacity: 0, duration: 1, ease: 'expo.out',
    });
    gsap.from('.map-frame', {
      scrollTrigger: { trigger: '.map-grid', start: 'top 82%' },
      x: 40, opacity: 0, duration: 1, ease: 'expo.out',
    });

    // ===== Footer =====
    gsap.from('.footer-grid > *', {
      scrollTrigger: { trigger: '.footer', start: 'top 88%' },
      y: 30, opacity: 0, stagger: 0.1, duration: 0.9,
    });

    // ===== WhatsApp float entrance =====
    gsap.from('#whatsappFloat', {
      scale: 0, opacity: 0, duration: 0.7, delay: 1.5, ease: 'back.out(1.8)',
    });

    // ===== Smooth anchor scroll =====
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const id = a.getAttribute('href');
        if (!id || id === '#') return;
        const target = document.querySelector(id);
        if (target) {
          e.preventDefault();
          const y = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
    });
  </script>
</Layout>
