---
export const prerender = false;
const ya = Astro.url.searchParams.get('ya') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Gracias · Happy Dent</title>
    <link rel="icon" type="image/svg+xml" href="/happy-dent.svg" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f7f3f8;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        color: #1f2430;
        -webkit-font-smoothing: antialiased;
      }
      .card {
        background: #fff;
        border-radius: 20px;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 8px 40px rgba(31,36,48,0.10);
        text-align: center;
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 2rem; justify-content: center; }
      .brand img { width: 36px; height: 36px; }
      .brand span { font-size: 1.15rem; font-weight: 800; }
      .icon { font-size: 3rem; margin-bottom: 1rem; }
      h1 { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.6rem; }
      p { color: #6b7280; font-size: 0.95rem; line-height: 1.6; }
      .back { display: inline-block; margin-top: 1.75rem; color: #e87fb4; font-weight: 700; font-size: 0.9rem; text-decoration: none; }
      .back:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="brand">
        <img src="/happy-dent-icon.svg" alt="Happy Dent" />
        <span>Happy Dent</span>
      </div>
      {ya ? (
        <>
          <div class="icon">✓</div>
          <h1>Ya calificaste esta visita</h1>
          <p>Tu opinion fue registrada previamente. Muchas gracias.</p>
        </>
      ) : (
        <>
          <div class="icon">★</div>
          <h1>Gracias por tu opinion</h1>
          <p>Tu calificacion ha sido recibida. La revisaremos pronto y aparecera en nuestro sitio.</p>
        </>
      )}
      <a href="/" class="back">Visita nuestro sitio</a>
    </div>
  </body>
</html>
